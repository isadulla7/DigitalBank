<?xml version="1.0" encoding="utf-8"?>
<resources>

    <declare-styleable name="ChooseCardLayout">

    </declare-styleable>

    <declare-styleable name="AppBarWithSubtitle">
        <attr name="title" format="string" />
        <attr name="subtitle" format="string" />
        <attr name="additionalIcon" format="reference" />
    </declare-styleable>

    <declare-styleable name="EmptyView">
        <attr name="ev_title" format="string" />
        <attr name="ev_desc" format="string" />
        <attr name="ev_icon" format="reference" />
    </declare-styleable>

    <declare-styleable name="MainAppBar">
        <attr name="s_title" format="string" />
        <attr name="s_additionalIcon" format="reference" />
        <attr name="s_tint" format="reference" />
    </declare-styleable>

    <declare-styleable name="MaskEditText">
        <attr name="met_mask" format="string" />
    </declare-styleable>

    <declare-styleable name="AmountEditText">
        <attr name="prefix" format="string" />
        <attr name="suffix" format="string" />
        <attr name="suffixPadding" format="dimension" />
    </declare-styleable>

    <declare-styleable name="ScannerOverlay">
        <attr name="square_width" format="integer" />
        <attr name="square_height" format="integer" />
        <attr name="line_color" format="color" />
        <attr name="line_width" format="integer" />
        <attr name="line_speed" format="integer" />
    </declare-styleable>

    <declare-styleable name="BaseTextInputLayout">
        <attr name="hint" format="string" />
        <attr name="maxLines" format="integer" />
        <attr name="maxLength" format="integer" />
        <attr name="text" format="string" />
        <attr name="textColor" format="reference" />
    </declare-styleable>

    <integer name="line_speed">5</integer>
    <integer name="line_width">4</integer>
    <integer name="scanner_rect_height">230</integer>
    <integer name="scanner_rect_width">230</integer>
    <color name="scanner_line">#00ceff</color>

    <declare-styleable name="CropOverlayView">
        <attr name="guideLines" format="boolean" />
        <attr name="marginTop" format="dimension" />
        <attr name="marginSide" format="dimension" />
        <attr name="minWidth" format="dimension" />
        <attr name="maxWidth" format="dimension" />
        <attr name="cornersRadius" format="dimension" />
        <attr name="overlayColor" format="color" />
    </declare-styleable>

    <declare-styleable name="AppWidgetAttrs">
        <attr name="appWidgetPadding" format="dimension" />
        <attr name="appWidgetInnerRadius" format="dimension" />
        <attr name="appWidgetRadius" format="dimension" />
    </declare-styleable>

</resources>