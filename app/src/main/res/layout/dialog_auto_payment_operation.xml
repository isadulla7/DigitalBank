<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="match_parent"
    android:background="@drawable/dialog_bg"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">


    <ImageView
        android:id="@+id/handle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_dialog_handle"
        tools:ignore="ContentDescription" />

    <uz.fido.utils.view.custom_text_view.TextViewMedium
        android:id="@+id/text_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:paddingEnd="16dp"
        android:gravity="center"
        android:paddingStart="16dp"
        android:textColor="@color/mainTextColor"
        app:layout_constraintTop_toBottomOf="@+id/handle"
        android:textSize="16sp"
        android:text="@string/add_my_house" />


    <uz.fido.utils.view.custom_text_view.TextViewMedium
        android:id="@+id/edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        android:drawablePadding="16dp"
        android:drawableStart="@drawable/ic_edit_house"
        android:paddingStart="16dp"
        android:paddingVertical="16dp"
        android:text="@string/edit_house"
        android:textColor="@color/mainTextColor"/>

    <uz.fido.utils.view.custom_text_view.TextViewMedium
        android:id="@+id/delete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:drawablePadding="16dp"
        android:drawableStart="@drawable/ic_delete_red"
        android:paddingStart="16dp"
        android:paddingVertical="16dp"
        android:text="@string/delete"
        android:layout_marginBottom="16dp"
        android:textColor="@color/brandRedColor"/>
</androidx.appcompat.widget.LinearLayoutCompat>