<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/home_page_gradient"
        app:layout_constraintHeight_percent="0.8"
        app:layout_constraintTop_toTopOf="parent" />

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/user_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:src="@drawable/ic_profile_image_empty"
        app:layout_constraintBottom_toBottomOf="@id/user_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/user_name"
        tools:ignore="ContentDescription" />

    <uz.fido.utils.view.custom_text_view.TextViewMedium
        android:id="@+id/user_name"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="start|center"
        android:maxLines="2"
        android:textColor="@color/brandBlueColor"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@id/chat"
        app:layout_constraintStart_toEndOf="@id/user_avatar"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Husniddin Madaminov" />

    <ImageView
        android:id="@+id/chat"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12sp"
        android:src="@drawable/ic_chat"
        app:layout_constraintBottom_toBottomOf="@id/user_name"
        app:layout_constraintEnd_toStartOf="@id/notifications"
        app:layout_constraintTop_toTopOf="@id/user_name"
        app:tint="@color/brandBlueColor"
        tools:ignore="ContentDescription" />

    <ImageView
        android:id="@+id/notifications"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="4dp"
        android:padding="12sp"
        android:src="@drawable/ic_home_notification"
        app:layout_constraintBottom_toBottomOf="@id/user_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/user_name"
        app:tint="@color/brandBlueColor"
        tools:ignore="ContentDescription" />

    <uz.fido.utils.view.custom_text_view.TextViewMedium
        android:id="@+id/notification_item"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_margin="16dp"
        android:background="@drawable/notification_backgroud"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/frozenBlue"
        android:textSize="10sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="5" />

    <uz.fido.utils.libs.smart_refresh.refresh_layout.SmartRefreshLayout
        android:id="@+id/refreshLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/user_name"
        app:srlAccentColor="@color/brandRedColor"
        app:srlEnableNestedScrolling="true"
        app:srlEnablePreviewInEditMode="false">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/add_card_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/cornered_bg_12dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <uz.fido.utils.view.custom_text_view.TextViewMedium
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/you_have_no_cards"
                        android:textColor="@color/brandBlueColor_50"
                        android:textSize="16sp" />

                    <uz.fido.utils.view.custom_text_view.TextViewRegular
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/no_card_description"
                        android:textColor="@color/brandBlueColor_50"
                        android:textSize="14sp" />

                    <uz.fido.utils.view.custom_text_view.TextViewMedium
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        android:drawableStart="@drawable/ic_add_red_24"
                        android:drawablePadding="8dp"
                        android:gravity="center"
                        android:text="@string/add_card"
                        android:textColor="@color/brandRedColor"
                        android:textSize="16sp" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/user_cards_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp">

                    <uz.fido.utils.view.custom_text_view.TextViewSemiBold
                        android:id="@+id/tv_my_cards"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:text="@string/my_cards"
                        android:textSize="20sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <uz.fido.utils.view.custom_text_view.TextViewMedium
                        android:id="@+id/btn_show_more"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:drawableEnd="@drawable/arrow_right_icon"
                        android:drawablePadding="8dp"
                        android:drawableTint="@color/brandRedColor"
                        android:gravity="center"
                        android:paddingVertical="4dp"
                        android:text="@string/all"
                        android:textColor="@color/brandRedColor"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toBottomOf="@id/tv_my_cards"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tv_my_cards" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/user_cards"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:paddingHorizontal="8dp"
                        android:paddingBottom="8dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_my_cards"
                        tools:itemCount="2"
                        tools:listitem="@layout/item_new_home_user_card" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/widgets_layout"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="16dp"
                    android:layout_weight="1"
                    android:background="@drawable/home_page_background"
                    android:clipToPadding="false"
                    android:orientation="vertical">

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.core.widget.NestedScrollView>

    </uz.fido.utils.libs.smart_refresh.refresh_layout.SmartRefreshLayout>

</androidx.constraintlayout.widget.ConstraintLayout>