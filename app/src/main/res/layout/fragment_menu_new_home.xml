<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/home_page_gradient"
        app:layout_constraintHeight_percent="0.85"
        app:layout_constraintTop_toTopOf="parent" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottie_file"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.8"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_loop="true" />

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/user_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:src="@drawable/ic_profile_image_empty"
        app:layout_constraintBottom_toBottomOf="@id/user_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/user_name"
        tools:ignore="ContentDescription" />

    <uz.fido.utils.view.custom_text_view.TextViewMedium
        android:id="@+id/user_name"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="start|center"
        android:maxLines="2"
        android:textColor="@color/brandBlueColor"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@id/chat"
        app:layout_constraintStart_toEndOf="@id/user_avatar"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Husniddin Madaminov" />

    <ImageView
        android:id="@+id/chat"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12sp"
        android:src="@drawable/ic_chat"
        app:layout_constraintBottom_toBottomOf="@id/user_name"
        app:layout_constraintEnd_toStartOf="@id/notifications"
        app:layout_constraintTop_toTopOf="@id/user_name"
        app:tint="@color/brandBlueColor"
        tools:ignore="ContentDescription" />

    <ImageView
        android:id="@+id/notifications"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="4dp"
        android:padding="12sp"
        android:src="@drawable/ic_home_notification"
        app:layout_constraintBottom_toBottomOf="@id/user_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/user_name"
        app:tint="@color/brandBlueColor"
        tools:ignore="ContentDescription" />

    <uz.fido.utils.view.custom_text_view.TextViewMedium
        android:id="@+id/notification_item"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_margin="16dp"
        android:background="@drawable/notification_backgroud"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/frozenBlue"
        android:textSize="10sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="5" />

    <uz.fido.utils.libs.smart_refresh.refresh_layout.SmartRefreshLayout
        android:id="@+id/refreshLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/user_name"
        app:srlAccentColor="@color/brandRedColor"
        app:srlEnableNestedScrolling="true"
        app:srlEnablePreviewInEditMode="false">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/add_card_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/cornered_bg_12dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <uz.fido.utils.view.custom_text_view.TextViewMedium
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/you_have_no_cards"
                        android:textColor="@color/brandBlueColor_50"
                        android:textSize="16sp" />

                    <uz.fido.utils.view.custom_text_view.TextViewRegular
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/no_card_description"
                        android:textColor="@color/brandBlueColor_50"
                        android:textSize="14sp" />

                    <uz.fido.utils.view.custom_text_view.TextViewMedium
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        android:drawableStart="@drawable/ic_add_red_24"
                        android:drawablePadding="8dp"
                        android:gravity="center"
                        android:text="@string/add_card"
                        android:textColor="@color/brandRedColor"
                        android:textSize="16sp" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/user_cards_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp">

                    <uz.fido.utils.view.custom_text_view.TextViewSemiBold
                        android:id="@+id/tv_my_cards"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:text="@string/my_cards"
                        android:textColor="@color/brandBlueColor"
                        android:textSize="20sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <uz.fido.utils.view.custom_text_view.TextViewMedium
                        android:id="@+id/btn_show_more"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:drawableEnd="@drawable/arrow_right_icon"
                        android:drawablePadding="8dp"
                        android:drawableTint="@color/brandRedColor"
                        android:gravity="center"
                        android:paddingVertical="4dp"
                        android:text="@string/all"
                        android:textColor="@color/brandRedColor"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toBottomOf="@id/tv_my_cards"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tv_my_cards" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/user_cards"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:paddingHorizontal="8dp"
                        android:paddingBottom="8dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_my_cards"
                        tools:itemCount="2"
                        tools:listitem="@layout/item_new_home_user_card" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/widgets_layout"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="16dp"
                    android:layout_weight="1"
                    android:background="@drawable/new_home_page_background"
                    android:clipToPadding="false"
                    android:orientation="vertical">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="16dp">

                        <uz.fido.utils.view.custom_text_view.TextViewSemiBold
                            android:id="@+id/title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_weight="1"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:text="@string/transfer"
                            android:textColor="@color/brandBlueColor"
                            android:textSize="16sp"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/phone_number_layout"
                            style="@style/EditTextInputLayoutStyle"
                            android:layout_width="0dp"
                            android:layout_height="68dp"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="8dp"
                            android:hint="@string/card_or_phone_number"
                            android:paddingVertical="4dp"
                            app:layout_constraintEnd_toStartOf="@+id/phone_card"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/title">

                            <EditText
                                android:id="@+id/et_phone_number"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/new_cornered_bg_12dp_stroke"
                                android:digits="+0123456789 "
                                android:imeOptions="actionNext"
                                android:inputType="number"
                                android:theme="@style/DefaultEditTextTheme" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <ImageView
                            android:id="@+id/btn_contact"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="@string/phone_for_contact"
                            android:padding="12sp"
                            android:src="@drawable/ic_star_unselected"
                            android:visibility="visible"
                            app:layout_constraintBottom_toBottomOf="@id/phone_number_layout"
                            app:layout_constraintEnd_toEndOf="@id/phone_number_layout"
                            app:layout_constraintTop_toTopOf="@id/phone_number_layout" />

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:id="@+id/phone_card"
                            android:layout_width="56dp"
                            android:layout_height="60dp"
                            android:layout_marginVertical="16dp"
                            android:layout_marginEnd="16dp"
                            android:background="@drawable/new_cornered_bg_12dp_stroke"
                            android:gravity="center"
                            app:layout_constraintBottom_toBottomOf="@+id/phone_number_layout"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/phone_number_layout">

                            <ImageView
                                android:id="@+id/image_type"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_phone_28" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="16dp">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:id="@+id/ll_fast_access"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="4dp">

                            <uz.fido.utils.view.custom_text_view.TextViewSemiBold
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/fast_access"
                                android:textColor="@color/brandBlueColor"
                                android:textSize="16sp" />

                            <uz.fido.utils.view.custom_text_view.TextViewMedium
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/edit"
                                android:textColor="@color/brandBlueColor"
                                android:textSize="14sp" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_fast_access"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:clipToPadding="false"
                            android:paddingStart="16dp"
                            android:paddingEnd="8dp"
                            tools:itemCount="1"
                            tools:listitem="@layout/item_new_home_fast_access_layout" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/home_templates_parent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="16dp">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="4dp">

                            <uz.fido.utils.view.custom_text_view.TextViewSemiBold
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/saved_payments"
                                android:textColor="@color/brandBlueColor"
                                android:textSize="16sp" />

                            <ImageView
                                android:id="@+id/templates_expandable_handle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/templates"
                                android:src="@drawable/ic_arrow_down" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <net.cachapa.expandablelayout.ExpandableLayout
                            android:id="@+id/template_expandable"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:el_duration="500"
                            app:el_parallax="0">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_templates"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:clipToPadding="false"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="4dp"
                                tools:listitem="@layout/item_payment_template" />

                        </net.cachapa.expandablelayout.ExpandableLayout>

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/home_my_house_parent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="16dp">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="4dp">

                            <uz.fido.utils.view.custom_text_view.TextViewSemiBold
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/my_house"
                                android:textColor="@color/brandBlueColor"
                                android:textSize="16sp" />

                            <ImageView
                                android:id="@+id/my_house_expandable_handle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/templates"
                                android:src="@drawable/ic_arrow_down" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <net.cachapa.expandablelayout.ExpandableLayout
                            android:id="@+id/my_house_expandable"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:el_duration="500"
                            app:el_parallax="0">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_my_house"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:clipToPadding="false"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="4dp"
                                tools:listitem="@layout/item_payment_template" />

                        </net.cachapa.expandablelayout.ExpandableLayout>

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/back_to_old_design"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/new_cornered_bg_12dp_stroke"
                        android:gravity="center">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <uz.fido.utils.view.custom_text_view.TextViewBold
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="-4dp"
                                android:drawableStart="@drawable/ic_universal_logo_red"
                                android:drawablePadding="8dp"
                                android:gravity="center"
                                android:text="Universalbank Pro"
                                android:textColor="@color/brandBlueColor"
                                android:textSize="17sp" />

                            <uz.fido.utils.view.custom_text_view.TextViewRegular
                                android:layout_width="wrap_content"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:paddingVertical="12dp"
                                android:text="@string/try_universalbankpro_s_sleek_new_app_mode"
                                android:textColor="@color/brandBlueColor_50"
                                android:textSize="15sp" />

                            <uz.fido.utils.view.custom_text_view.TextViewMedium
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/red_gradient_background_12dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:paddingHorizontal="24dp"
                                android:paddingVertical="8dp"
                                android:text="@string/try_now"
                                android:textColor="@color/brandRedColor"
                                android:textSize="13sp" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <ImageView
                            android:layout_width="84dp"
                            android:layout_height="112dp"
                            android:layout_marginVertical="12dp"
                            android:layout_marginEnd="16dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/rocket_app" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.core.widget.NestedScrollView>

    </uz.fido.utils.libs.smart_refresh.refresh_layout.SmartRefreshLayout>

</androidx.constraintlayout.widget.ConstraintLayout>