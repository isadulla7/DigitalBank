<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/father"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="16dp"
    android:background="@drawable/cornered_bg_12dp_stroke"
    android:padding="16dp"
    android:paddingBottom="12dp">

    <uz.fido.utils.view.custom_text_view.TextViewMedium
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/brandBlueColor"
        android:textSize="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Технические работы!" />

    <uz.fido.utils.view.custom_text_view.TextViewRegular
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="4"
        android:textColor="@color/brandBlueColor_40"
        android:textSize="14dp"
        app:layout_constraintTop_toBottomOf="@id/title"
        tools:text="Уважаемые клиенты! В связи с проведением работ на сети партнеров АК Узбектелеком..." />

    <uz.fido.utils.view.custom_text_view.TextViewRegular
        android:id="@+id/date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/brandBlueColor"
        android:textSize="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/description"
        tools:text="Сегодня, 12:22" />

</androidx.constraintlayout.widget.ConstraintLayout>