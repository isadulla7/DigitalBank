<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dialog_bg"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/handle"
        android:layout_width="36dp"
        android:layout_height="5dp"
        android:layout_gravity="center"
        android:layout_marginTop="5dp"
        android:src="@drawable/ic_dialog_handle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <uz.fido.utils.view.custom_text_view.TextViewMedium
        android:id="@+id/text_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/select_period"
        android:textColor="@color/mainTextColor"
        android:textSize="16dp"
        app:layout_constraintTop_toBottomOf="@+id/handle" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/input_from_date"
        style="@style/EditTextInputLayoutStyle"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="20dp"
        app:layout_constraintTop_toBottomOf="@+id/text_name">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/ed_date"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:drawablePadding="16dp"
            android:focusableInTouchMode="false"
            android:focusedByDefault="false"
            android:gravity="center_vertical"
            android:hint="@string/from"
            android:inputType="number"
            android:theme="@style/DefaultEditTextTheme" />
    </com.google.android.material.textfield.TextInputLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/start"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_calendar_filter_monitoring"
        app:layout_constraintBottom_toBottomOf="@+id/input_from_date"
        app:layout_constraintEnd_toEndOf="@+id/input_from_date"
        app:layout_constraintTop_toTopOf="@+id/input_from_date" />


    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/input_up_to_date"
        style="@style/EditTextInputLayoutStyle"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="20dp"
        app:layout_constraintTop_toBottomOf="@+id/input_from_date">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/ed_date_up_to"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:drawablePadding="16dp"
            android:focusableInTouchMode="false"
            android:focusedByDefault="false"
            android:gravity="center_vertical"
            android:hint="@string/before"
            android:inputType="number"
            android:theme="@style/DefaultEditTextTheme" />
    </com.google.android.material.textfield.TextInputLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/end_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_calendar_filter_monitoring"
        app:layout_constraintBottom_toBottomOf="@+id/input_up_to_date"
        app:layout_constraintEnd_toEndOf="@+id/input_up_to_date"
        app:layout_constraintTop_toTopOf="@+id/input_up_to_date" />

    <uz.fido.utils.view.custom_circle_button.CustomFAButton
        android:id="@+id/btn_continue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:enabled="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_up_to_date" />
</androidx.constraintlayout.widget.ConstraintLayout>