<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/template"
    android:layout_width="120dp"
    android:layout_height="100dp"
    android:layout_margin="4dp"
    android:background="@drawable/cornered_bg_12dp_stroke"
    android:elevation="28dp"
    android:orientation="vertical"
    android:outlineSpotShadowColor="#0AFFFFFF"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/shimmer_circle_2"
        tools:ignore="ContentDescription" />

    <uz.fido.utils.view.custom_text_view.TextViewMedium
        android:id="@+id/template_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/shimmer_bg_2"
        android:ellipsize="end"
        android:textSize="12sp" />

    <uz.fido.utils.view.custom_text_view.TextViewRegular
        android:id="@+id/template_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/shimmer_bg_2"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="10sp" />

</androidx.appcompat.widget.LinearLayoutCompat>