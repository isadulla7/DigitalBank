<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/father"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:orientation="vertical"
    android:paddingEnd="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="130dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/card_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_1"
            app:shapeAppearance="@style/cardBackground"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/card_type"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/ic_visa"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/bank_logo"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_bank_logo_anorbank"
            app:layout_constraintBottom_toBottomOf="@id/card_type"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/card_type"
            tools:ignore="ContentDescription" />

        <uz.fido.utils.view.custom_text_view.TextViewBold
            android:id="@+id/card_balance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:includeFontPadding="false"
            android:textColor="@color/frozenWhite"
            android:textSize="20dp"
            app:layout_constraintBottom_toTopOf="@id/tv_main_card"
            app:layout_constraintTop_toBottomOf="@id/bank_logo"
            tools:text="5 557 000 UZS" />

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:id="@+id/tv_main_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="16dp"
            android:includeFontPadding="false"
            android:text="@string/main_card"
            android:textColor="@color/frozenWhite"
            android:textSize="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:id="@+id/card_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:textColor="@color/frozenWhite"
            android:textSize="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="**0924" />

        <View
            android:id="@+id/error_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/card_error_background"
            android:gravity="center"
            android:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <uz.fido.utils.view.custom_text_view.TextViewMedium
        android:id="@+id/error_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center|start"
        android:text="@string/not_enough_money"
        android:textColor="@color/brandRedColor"
        android:textSize="14dp"
        app:layout_constraintTop_toBottomOf="@id/cards" />


</androidx.appcompat.widget.LinearLayoutCompat>