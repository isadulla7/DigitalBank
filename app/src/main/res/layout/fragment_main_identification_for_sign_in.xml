<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragments.profile.identification.MainIdentificationFragment">

    <uz.fido.utils.view.custom_text_view.TextViewBold
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="56dp"
        android:text="@string/online_identification"
        android:textColor="@color/brandBlueColor"
        android:textSize="24sp"
        app:layout_constraintTop_toTopOf="parent" />

    <uz.fido.utils.view.custom_text_view.TextViewRegular
        android:id="@+id/tv_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:text="@string/identification_login_desc"
        android:textColor="#848E9D"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tv_title" />

    <ImageView
        android:id="@+id/illustration"
        android:layout_width="300dp"
        android:layout_height="300dp"
        app:layout_constraintBottom_toTopOf="@id/identification_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_description"
        tools:ignore="ContentDescription" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/skip_btn"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginVertical="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:includeFontPadding="false"
        android:text="@string/return_back"
        android:textColor="@color/brandRedColor"
        android:textSize="16sp"
        app:backgroundTint="#F4DBDB"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/identification_btn"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/identification_btn"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginVertical="16dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="16dp"
        android:layout_weight="1"
        android:includeFontPadding="false"
        android:text="@string/identify"
        android:textColor="@color/frozenWhite"
        android:textSize="16sp"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/skip_btn" />

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        android:indeterminateTint="@color/white"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/identification_btn"
        app:layout_constraintStart_toStartOf="@id/identification_btn"
        app:layout_constraintTop_toTopOf="@id/identification_btn" />

</androidx.constraintlayout.widget.ConstraintLayout>