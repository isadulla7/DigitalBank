<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/father"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:background="?selectableItemBackground">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:src="@drawable/shimmer_circle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/payment_name"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="16sp"
        android:layout_marginEnd="8dp"
        android:gravity="center|start"
        android:orientation="vertical"
        app:layout_constraintEnd_toStartOf="@id/payment_amount"
        app:layout_constraintStart_toEndOf="@id/icon"
        app:layout_constraintTop_toTopOf="@id/icon">

        <uz.fido.utils.view.custom_text_view.TextViewRegular
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:background="@drawable/shimmer_bg" />

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/shimmer_bg" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <uz.fido.utils.view.custom_text_view.TextViewRegular
        android:id="@+id/payment_amount"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12sp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/shimmer_bg"
        android:gravity="end"
        android:maxLines="1"
        android:textColor="@color/mainTextColor"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/payment_name"
        app:layout_constraintTop_toTopOf="parent" />

    <uz.fido.utils.view.custom_text_view.TextViewRegular
        android:id="@+id/service_name"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12sp"
        android:layout_marginTop="4dp"
        android:background="@drawable/shimmer_bg"
        android:textColor="@color/hintColor"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/payment_amount"
        app:layout_constraintTop_toBottomOf="@id/payment_amount" />



</androidx.constraintlayout.widget.ConstraintLayout>