<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sum_card_block"
    android:layout_width="match_parent"
    android:layout_height="72dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginEnd="8dp"
        android:elevation="28dp"
        android:outlineSpotShadowColor="@color/brandBlueColor_10">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/card_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:shapeAppearance="@style/cardBackground" />

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:id="@+id/sender_card_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/frozenWhite"
            android:textSize="12dp"
            app:layout_constraintEnd_toStartOf="@id/sender_card_type"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Карта для покупок" />

        <uz.fido.utils.view.custom_text_view.TextViewSemiBold
            android:id="@+id/sender_card_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="10dp"
            android:includeFontPadding="false"
            android:textColor="@color/frozenWhite"
            android:textSize="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="7 519 900 UZS" />

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:id="@+id/card_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/red_card_background"
            android:gravity="center|start"
            android:paddingStart="16dp"
            android:paddingEnd="24dp"
            android:text="@string/card_blocked"
            android:textColor="@color/frozenWhite"
            android:textSize="14dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/sender_card_type"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_visa"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/frozenWhite"
            tools:ignore="ContentDescription" />

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:id="@+id/sender_card_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="10dp"
            android:textColor="@color/frozenWhite"
            android:textSize="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="**1356" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.appcompat.widget.LinearLayoutCompat>