<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/father"
    android:background="@drawable/cornered_bg_12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="16dp">

    <uz.fido.utils.view.custom_text_view.TextViewMedium
        android:id="@+id/tv_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/brandBlueColor"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        android:textSize="16sp"
        tools:text="My Deposit" />

    <uz.fido.utils.view.custom_text_view.TextViewSemiBold
        android:id="@+id/tv_balance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_name"
        android:textColor="@color/brandBlueColor"
        android:textSize="20sp"
        android:layout_marginHorizontal="16dp"
        tools:text="215 000 000 UZS" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_balance"
        android:indeterminateTint="@color/brandRedColor"
        android:progress="30"
        android:layout_marginHorizontal="16dp"
        app:trackColor="@color/brandBlueColor_10"
        app:trackCornerRadius="4dp"
        app:trackThickness="6dp" />

    <uz.fido.utils.view.custom_text_view.TextViewMedium
        android:id="@+id/tv_left_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="Test"
        android:layout_marginTop="6dp"
        android:textColor="@color/brandBlueColor"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/progress_view"
        android:textSize="14sp" />

    <uz.fido.utils.view.custom_text_view.TextViewMedium
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="33dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@color/brandRedColor"
        android:textColor="@color/whiteColor"
        android:gravity="center"
        android:visibility="gone"
        android:text="@string/target_suspended"
        android:textSize="14sp" />
</androidx.constraintlayout.widget.ConstraintLayout>