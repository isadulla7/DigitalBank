<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/father"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="12dp"
    android:background="@drawable/cornered_bg_12dp_stroke"
    android:gravity="center"
    android:paddingStart="12sp"
    android:paddingEnd="16sp">

    <ImageView
        android:id="@+id/image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/logo_zolotaya_korona"
        tools:ignore="ContentDescription" />

    <uz.fido.utils.view.custom_text_view.TextViewMedium
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="16sp"
        android:layout_weight="1"
        android:gravity="center|start"
        android:textColor="@color/mainTextColor"
        android:textSize="16dp"
        tools:text="Zolotoya korona" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_arrow_left_ios"
        app:tint="@color/brandBlueColor_30"
        tools:ignore="ContentDescription" />

</androidx.appcompat.widget.LinearLayoutCompat>
