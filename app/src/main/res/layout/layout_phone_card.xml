<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="20dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/all_transfers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <uz.fido.utils.view.custom_text_view.TextViewSemiBold
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/payments"
            android:textColor="@color/brandBlueColor"
            android:textSize="16dp" />

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/all"
            android:textColor="@color/brandBlueColor"
            android:textSize="14dp"
            android:visibility="gone" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/phone_number_layout"
        style="@style/EditTextInputLayoutStyle"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:hint="@string/card_or_phone_number"
        android:paddingVertical="4dp"
        app:layout_constraintEnd_toStartOf="@+id/phone_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/all_transfers">

        <EditText
            android:id="@+id/et_phone_number"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/cornered_bg_12dp"
            android:digits="+0123456789 "
            android:imeOptions="actionNext"
            android:inputType="number"
            android:theme="@style/DefaultEditTextTheme" />

    </com.google.android.material.textfield.TextInputLayout>

    <ImageView
        android:id="@+id/btn_contact"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12sp"
        android:src="@drawable/ic_star_unselected"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@id/phone_number_layout"
        app:layout_constraintEnd_toEndOf="@id/phone_number_layout"
        app:layout_constraintTop_toTopOf="@id/phone_number_layout" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/phone_card"
        android:layout_width="56dp"
        android:layout_height="60dp"
        android:layout_marginVertical="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/cornered_bg_12dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="@+id/phone_number_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/phone_number_layout">

        <ImageView
            android:id="@+id/image_type"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_phone_28" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.constraintlayout.widget.ConstraintLayout>