<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <uz.fido.utils.view.custom_app_bar.MainAppBar
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:s_title="@string/humo_pay" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/pin_code_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBar">

        <uz.fido.utils.view.custom_text_view.TextViewSemiBold
            android:id="@+id/welcome_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:gravity="center"
            android:text="@string/humo_pay"
            android:textColor="@color/mainTextColor"
            android:textSize="16sp"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/dot_view"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:clipToPadding="false"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            app:layout_constraintBottom_toTopOf="@id/num2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/welcome_text">

            <ImageView
                android:id="@+id/dot1"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/pin_dot_disable"
                tools:ignore="ContentDescription" />

            <ImageView
                android:id="@+id/dot2"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="16dp"
                android:src="@drawable/pin_dot_disable"
                tools:ignore="ContentDescription" />

            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:indeterminateTint="@color/brandRedColor"
                android:progressTint="@color/brandRedColor"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="@id/dot_view"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/dot_view" />

            <ImageView
                android:id="@+id/dot3"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/pin_dot_disable"
                tools:ignore="ContentDescription" />

            <ImageView
                android:id="@+id/dot4"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="16dp"
                android:src="@drawable/pin_dot_disable"
                tools:ignore="ContentDescription" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:id="@+id/error_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16sp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16sp"
            android:gravity="center"
            android:textColor="@color/brandRedColor"
            android:textSize="16sp"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/dot_view" />

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:id="@+id/num1"
            style="@style/pin_number_style"
            android:layout_marginEnd="28dp"
            android:text="1"
            app:layout_constraintBottom_toBottomOf="@id/num2"
            app:layout_constraintEnd_toStartOf="@id/num2"
            app:layout_constraintTop_toTopOf="@id/num2" />

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:id="@+id/num2"
            style="@style/pin_number_style"
            android:layout_marginBottom="28dp"
            android:text="2"
            app:layout_constraintBottom_toTopOf="@id/num5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:id="@+id/num3"
            style="@style/pin_number_style"
            android:layout_marginStart="28dp"
            android:text="3"
            app:layout_constraintBottom_toBottomOf="@id/num2"
            app:layout_constraintStart_toEndOf="@id/num2"
            app:layout_constraintTop_toTopOf="@id/num2" />

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:id="@+id/num4"
            style="@style/pin_number_style"
            android:layout_marginEnd="28dp"
            android:text="4"
            app:layout_constraintBottom_toBottomOf="@id/num5"
            app:layout_constraintEnd_toStartOf="@id/num2"
            app:layout_constraintTop_toTopOf="@id/num5" />

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:id="@+id/num5"
            style="@style/pin_number_style"
            android:layout_marginBottom="28dp"
            android:text="5"
            app:layout_constraintBottom_toTopOf="@id/num8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:id="@+id/num6"
            style="@style/pin_number_style"
            android:layout_marginStart="28dp"
            android:text="6"
            app:layout_constraintBottom_toBottomOf="@id/num5"
            app:layout_constraintStart_toEndOf="@id/num2"
            app:layout_constraintTop_toTopOf="@id/num5" />

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:id="@+id/num7"
            style="@style/pin_number_style"
            android:layout_marginEnd="28dp"
            android:text="7"
            app:layout_constraintBottom_toBottomOf="@id/num8"
            app:layout_constraintEnd_toStartOf="@id/num2"
            app:layout_constraintTop_toTopOf="@id/num8" />

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:id="@+id/num8"
            style="@style/pin_number_style"
            android:layout_marginBottom="28dp"
            android:text="8"
            app:layout_constraintBottom_toTopOf="@id/num0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:id="@+id/num9"
            style="@style/pin_number_style"
            android:layout_marginStart="28dp"
            android:text="9"
            app:layout_constraintBottom_toBottomOf="@id/num8"
            app:layout_constraintStart_toEndOf="@id/num2"
            app:layout_constraintTop_toTopOf="@id/num8" />

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:id="@+id/num0"
            style="@style/pin_number_style"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="28dp"
            android:text="0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/clear"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:alpha="0.15"
            android:src="@drawable/ic_backspace"
            app:layout_constraintBottom_toBottomOf="@id/num0"
            app:layout_constraintEnd_toEndOf="@id/num9"
            app:layout_constraintStart_toStartOf="@id/num9"
            app:layout_constraintTop_toTopOf="@id/num0"
            tools:ignore="ContentDescription" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/payment_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBar">

        <uz.fido.utils.view.custom_text_view.TextViewBold
            android:id="@+id/tv_cards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:ellipsize="end"
            android:gravity="start"
            android:includeFontPadding="false"
            android:text="@string/write_off_card"
            android:textColor="@color/brandBlueColor"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tv_cards">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/card_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_1"
                app:shapeAppearance="@style/cardBackground"
                tools:ignore="ContentDescription" />

            <ImageView
                android:id="@+id/card_type"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:src="@drawable/ic_humo_white_24"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="ContentDescription" />

            <ImageView
                android:id="@+id/bank_logo"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_bank_logo_anorbank"
                app:layout_constraintBottom_toBottomOf="@id/card_type"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/card_type"
                tools:ignore="ContentDescription" />

            <uz.fido.utils.view.custom_text_view.TextViewBold
                android:id="@+id/card_balance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:includeFontPadding="false"
                android:textColor="@color/whiteColor"
                android:textSize="20sp"
                app:layout_constraintBottom_toTopOf="@id/tv_main_card"
                app:layout_constraintTop_toBottomOf="@id/bank_logo"
                tools:text="5 557 000 UZS" />

            <uz.fido.utils.view.custom_text_view.TextViewMedium
                android:id="@+id/tv_main_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="16dp"
                android:includeFontPadding="false"
                android:text="@string/main_card"
                android:textColor="@color/whiteColor"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <uz.fido.utils.view.custom_text_view.TextViewMedium
                android:id="@+id/card_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:textColor="@color/whiteColor"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="**0924" />

            <View
                android:id="@+id/error_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/card_error_background"
                android:gravity="center"
                android:visibility="visible" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <uz.fido.utils.view.custom_text_view.TextViewRegular
            android:id="@+id/timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/humo_pay_timer"
            android:textColor="@color/hintColor"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/continue_button"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="16dp"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/pay"
            android:textColor="@color/frozenWhite"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            app:layout_constraintBottom_toBottomOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>