<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:background="@drawable/main_8dp_stroke">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_margin="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <uz.fido.utils.view.custom_text_view.TextViewRegular
        android:id="@+id/payment_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/mainTextColor"
        android:textSize="16dp"
        app:layout_constraintEnd_toStartOf="@id/payment_amount"
        app:layout_constraintStart_toEndOf="@id/icon"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="@string/payment_in_places" />

    <uz.fido.utils.view.custom_text_view.TextViewRegular
        android:id="@+id/payment_type"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/brandBlueColor_40"
        android:textSize="12dp"
        android:visibility="visible"
        app:layout_constraintEnd_toStartOf="@id/text_date"
        app:layout_constraintStart_toEndOf="@id/icon"
        app:layout_constraintTop_toBottomOf="@id/payment_name"
        tools:text="@string/payment_in_places" />

    <uz.fido.utils.view.custom_text_view.TextViewRegular
        android:id="@+id/payment_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:maxLines="1"
        android:textColor="@color/mainTextColor"
        android:textSize="16dp"
        app:layout_constraintBottom_toBottomOf="@id/payment_name"
        app:layout_constraintEnd_toStartOf="@+id/image_more"
        app:layout_constraintTop_toTopOf="@id/payment_name"
        app:layout_goneMarginStart="8dp"
        tools:text="12 500 UZS" />

    <uz.fido.utils.view.custom_text_view.TextViewRegular
        android:id="@+id/text_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLength="10"
        android:textColor="@color/color_auto_activ"
        android:textSize="12dp"
        app:layout_constraintBottom_toBottomOf="@id/payment_type"
        app:layout_constraintEnd_toStartOf="@+id/image_more"
        app:layout_constraintTop_toTopOf="@id/payment_type"
        tools:text="@string/active" />

    <ImageView
        android:id="@+id/image_more"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="10dp"
        android:src="@drawable/more"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#9DA4B0"
        tools:ignore="ContentDescription" />
</androidx.constraintlayout.widget.ConstraintLayout>
