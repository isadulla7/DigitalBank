<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:clipChildren="false">

    <uz.fido.utils.view.custom_app_bar.MainAppBar
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/whiteColor"
        app:layout_constraintTop_toTopOf="parent"
        app:s_title="@string/over_my_cards" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/app_bar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <uz.fido.utils.view.custom_text_view.TextViewSemiBold
                android:id="@+id/from_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:includeFontPadding="false"
                android:text="@string/from_card"
                android:textColor="@color/mainTextColor"
                android:textSize="20sp"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.viewpager.widget.ViewPager
                android:id="@+id/sender_cards"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="16dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                app:layout_constraintTop_toBottomOf="@id/from_card" />

            <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
                android:id="@+id/sender_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="16dp"
                app:dotsColor="@color/brandBlueColor_10"
                app:dotsCornerRadius="6dp"
                app:dotsSize="6dp"
                app:dotsSpacing="4dp"
                app:dotsWidthFactor="1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/sender_cards"
                app:progressMode="false"
                app:selectedDotColor="@color/brandBlueColor_90" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/senders_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/sender_indicator"
                app:layout_constraintTop_toTopOf="@id/sender_cards">

                <uz.fido.utils.view.custom_text_view.TextViewMedium
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="16dp"
                    android:gravity="center"
                    android:text="@string/you_dont_have_card"
                    android:textColor="@color/brandBlueColor_50"
                    android:textSize="16sp" />

                <uz.fido.utils.view.custom_text_view.TextViewRegular
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="56dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/no_cards_desc_p2p"
                    android:textColor="@color/brandRedColor"
                    android:textSize="14sp" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <uz.fido.utils.view.custom_text_view.TextViewSemiBold
                android:id="@+id/to_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                android:includeFontPadding="false"
                android:text="@string/to_card_2"
                android:textColor="@color/mainTextColor"
                android:textSize="20sp"
                app:layout_constraintTop_toBottomOf="@id/sender_indicator" />

            <androidx.viewpager.widget.ViewPager
                android:id="@+id/receiver_cards"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="16dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                app:layout_constraintTop_toBottomOf="@id/to_card" />

            <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
                android:id="@+id/receiver_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="16dp"
                app:dotsColor="@color/brandBlueColor_10"
                app:dotsCornerRadius="6dp"
                app:dotsSize="6dp"
                app:dotsSpacing="4dp"
                app:dotsWidthFactor="1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/receiver_cards"
                app:progressMode="false"
                app:selectedDotColor="@color/brandBlueColor_90" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/receivers_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/receiver_indicator"
                app:layout_constraintTop_toTopOf="@id/receiver_cards">

                <uz.fido.utils.view.custom_text_view.TextViewMedium
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="16dp"
                    android:gravity="center"
                    android:text="@string/you_dont_have_second_card"
                    android:textColor="@color/brandBlueColor_50"
                    android:textSize="16sp" />

                <uz.fido.utils.view.custom_text_view.TextViewRegular
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="56dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/no_cards_desc_p2p"
                    android:textColor="@color/brandRedColor"
                    android:textSize="14sp" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/amount_layout"
                style="@style/EditTextInputLayoutStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                android:hint="@string/input_amount"
                app:layout_constraintTop_toBottomOf="@id/receiver_indicator">

                <uz.fido.utils.view.custom_edit_text.amount_edit_text.AmountEditText
                    android:id="@+id/et_amount"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:digits="1234567890. "
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:tag="AMOUNT"
                    android:theme="@style/DefaultEditTextTheme" />

            </com.google.android.material.textfield.TextInputLayout>

            <uz.fido.utils.view.amount.AmountSuggestionView
                android:id="@+id/amount_suggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/amount_layout" />

            <uz.fido.utils.view.custom_text_view.TextViewRegular
                android:id="@+id/tv_min_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:text="@string/min_amount_1000"
                android:textColor="@color/brandBlueColor_50"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/amount_suggestions"
                tools:text="1$ = 10430 сум" />

            <ProgressBar
                android:id="@+id/commission_progress"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:indeterminateTint="@color/brandRedColor"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_min_amount" />

            <uz.fido.utils.view.custom_text_view.TextViewRegular
                android:id="@+id/tv_commission"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:textColor="@color/brandBlueColor_50"
                android:textSize="14sp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/commission_progress"
                tools:text="1$ = 10430 сум" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <uz.fido.utils.view.custom_circle_button.CustomFAButton
        android:id="@+id/btn_continue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="1dp"
        android:enabled="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>