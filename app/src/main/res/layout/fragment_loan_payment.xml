<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <uz.fido.utils.view.custom_app_bar.MainAppBar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/whiteColor"
        android:id="@+id/app_bar"
        app:s_title="@string/payment_loan"
        android:outlineSpotShadowColor="@color/appBarShadowColor"
        android:translationZ="@dimen/elevation_8dp"
        app:layout_constraintTop_toTopOf="parent"/>


    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/amount_lin"
        style="@style/EditTextInputLayoutStyle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="24dp"
        android:hint="@string/amount"
        app:layout_constraintTop_toBottomOf="@id/app_bar">

        <uz.fido.utils.view.custom_edit_text.amount_edit_text.AmountEditText
            android:id="@+id/et_amount"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inputType="number"
            android:maxLength="10"
            android:maxLines="1"
            android:imeOptions="actionDone"
            android:digits=" 0123456789"
            android:theme="@style/DefaultEditTextTheme" />

    </com.google.android.material.textfield.TextInputLayout>


    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/linear"
        android:gravity="center_horizontal"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/amount_lin">

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:layout_width="wrap_content"
            android:textSize="16sp"
            android:gravity="center_horizontal"
            android:textColor="@color/brandRedColor"
            android:text="@string/recommeded_amount"
            android:layout_height="wrap_content"/>

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:id="@+id/max_amount"
            android:layout_width="wrap_content"
            android:textSize="16sp"
            android:layout_marginStart="10dp"
            android:textColor="@color/brandRedColor"
            android:text="2 2000 "
            android:layout_height="wrap_content"/>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/linear_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/linear">

        <uz.fido.utils.view.custom_text_view.TextViewRegular
            android:layout_width="match_parent"
            android:textSize="14sp"
            android:layout_weight="1"
            android:textColor="@color/mainTextColor"
            android:text="@string/pay_on_time"
            android:layout_height="wrap_content"/>

        <Switch
            android:id="@+id/switch_id"
            android:layout_width="match_parent"
            android:textSize="14sp"
            android:layout_weight="1"
            android:gravity="end"
            android:layout_height="wrap_content"/>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/lin_add"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/linear_switch"
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="wrap_content">


    </androidx.appcompat.widget.LinearLayoutCompat>



    <uz.fido.utils.view.custom_circle_button.CustomFAButton
        android:id="@+id/btn_continue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:layout_gravity="end"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>