<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/handle"
        android:layout_width="36dp"
        android:layout_height="5dp"
        android:layout_gravity="center"
        android:layout_marginTop="5dp"
        android:src="@drawable/ic_dialog_handle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <uz.fido.utils.view.custom_text_view.TextViewMedium
        android:id="@+id/tv_choose_function"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:paddingBottom="24dp"
        android:text="@string/choose_one_of_function"
        android:textColor="@color/mainTextColor"
        android:textSize="16dp"
        app:layout_constraintTop_toBottomOf="@id/handle" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_camera"
        style="@style/FloatingButtonStyle"
        android:enabled="true"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_camera_white"
        app:layout_constraintEnd_toStartOf="@id/btn_nfc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_choose_function" />

    <uz.fido.utils.view.custom_text_view.TextViewMedium
        android:id="@+id/tv_choose_camera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:paddingBottom="32dp"
        android:text="@string/via_camera"
        android:textColor="@color/mainTextColor"
        android:textSize="16dp"
        app:layout_constraintEnd_toEndOf="@id/btn_camera"
        app:layout_constraintStart_toStartOf="@id/btn_camera"
        app:layout_constraintTop_toBottomOf="@id/btn_camera" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_nfc"
        style="@style/FloatingButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:enabled="true"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_nfc_white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_camera"
        app:layout_constraintTop_toBottomOf="@id/tv_choose_function" />

    <uz.fido.utils.view.custom_text_view.TextViewMedium
        android:id="@+id/tv_choose_nfc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:paddingBottom="32dp"
        android:text="@string/via_nfc"
        android:textColor="@color/mainTextColor"
        android:textSize="16dp"
        app:layout_constraintEnd_toEndOf="@id/btn_nfc"
        app:layout_constraintStart_toStartOf="@id/btn_nfc"
        app:layout_constraintTop_toBottomOf="@id/btn_nfc" />

</androidx.constraintlayout.widget.ConstraintLayout>