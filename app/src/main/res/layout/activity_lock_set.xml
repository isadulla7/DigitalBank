<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@+id/button_continue"
        app:layout_constraintTop_toTopOf="parent">

        <uz.fido.utils.view.custom_text_view.TextViewSemiBold
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/data_security_function"
            android:textColor="@color/mainTextColor"
            android:textSize="30dp" />

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:id="@+id/tv_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/emulator_is_not_allowed"
            android:textColor="@color/mainTextColor"
            android:textSize="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/view_lottie"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginTop="16dp"
                app:lottie_autoPlay="true"
                app:lottie_fileName="anim_warning.json"
                app:lottie_loop="true" />

        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_continue"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginVertical="16dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="16dp"
        android:enabled="true"
        android:text="@string/continue_text"
        android:textColor="@color/frozenWhite"
        android:textSize="16dp"
        android:visibility="gone"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toTopOf="@+id/button_open_settings" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_open_settings"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginVertical="16dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="16dp"
        android:enabled="true"
        android:text="@string/exit"
        android:textColor="@color/frozenWhite"
        android:textSize="16dp"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>