<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <uz.fido.utils.view.custom_app_bar.MainAppBar
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:s_title="@string/open_card" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/card_image_layout"
                android:layout_width="270dp"
                android:layout_height="176dp"
                android:layout_gravity="center"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardUseCompatPadding="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/card_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:ignore="ContentDescription"
                    tools:src="@drawable/ic_card_type_humo" />
            </androidx.cardview.widget.CardView>

            <uz.fido.utils.view.custom_text_view.TextViewSemiBold
                android:id="@+id/order_card_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textColor="@color/mainTextColor"
                android:textSize="17sp"
                app:layout_constraintTop_toBottomOf="@id/card_image_layout"
                tools:text="Дебетовая карта UzCard" />

            <ImageView
                android:id="@+id/dash0"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/dashed_line"
                app:layout_constraintTop_toBottomOf="@id/order_card_type"
                tools:ignore="ContentDescription" />

            <uz.fido.utils.view.custom_text_view.TextViewRegular
                android:id="@+id/payment_system_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_weight="1"
                android:text="@string/payment_system"
                android:textColor="@color/hintColor"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dash0" />

            <uz.fido.utils.view.custom_text_view.TextViewMedium
                android:id="@+id/payment_system"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/mainTextColor"
                android:textSize="15sp"
                app:layout_constraintBottom_toBottomOf="@id/payment_system_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/payment_system_text"
                tools:text="UzCard" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/layout_product_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/payment_system">

                <TextView
                    android:id="@+id/tv_issue_cost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/issue_cost"
                    android:textColor="@color/hintColor"
                    android:textSize="14sp" />

                <uz.fido.utils.view.custom_text_view.TextViewMedium
                    android:id="@+id/issue_cost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/mainTextColor"
                    android:textSize="15sp"
                    tools:text="40500 UZS" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/layout_p2p_percent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/layout_product_price">

                <TextView
                    android:id="@+id/tv_p2p_percent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/transact_process_system"
                    android:textColor="@color/hintColor"
                    android:textSize="14sp" />

                <uz.fido.utils.view.custom_text_view.TextViewMedium
                    android:id="@+id/p2p_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/mainTextColor"
                    android:textSize="15sp"
                    tools:text="40500 UZS" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/layout_expire"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/layout_p2p_percent">

                <TextView
                    android:id="@+id/tv_expire"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/card_expire"
                    android:textColor="@color/hintColor"
                    android:textSize="14sp" />

                <uz.fido.utils.view.custom_text_view.TextViewMedium
                    android:id="@+id/expire"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/mainTextColor"
                    android:textSize="15sp"
                    tools:text="40500 UZS" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <ImageView
                android:id="@+id/dash1"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/dashed_line"
                app:layout_constraintTop_toBottomOf="@id/layout_expire"
                tools:ignore="ContentDescription" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/secret_word_layout"
                style="@style/EditTextInputLayoutStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/dash1">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_secret_word"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="@string/input_secret_word"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLength="100"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/mainTextColor"
                    android:textColorHint="@color/hintColor"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <uz.fido.utils.view.custom_text_view.TextViewRegular
                android:id="@+id/secret_word_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/secret_word_description"
                android:textColor="@color/brandRedColor"
                android:textSize="12sp"
                app:layout_constraintTop_toBottomOf="@id/secret_word_layout" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <CheckBox
        android:id="@+id/agreement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:text="@string/accept_deposit_privacy"
        app:layout_constraintTop_toBottomOf="@id/secret_word_desc" />


    <uz.fido.utils.view.custom_circle_button.CustomFAButton
        android:id="@+id/continue_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:enabled="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.appcompat.widget.LinearLayoutCompat>