<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/father"
    android:layout_width="84dp"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical">

    <uz.fido.utils.view.custom_text_view.TextViewMedium
        android:id="@+id/short_name"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_home_popular_transfer"
        android:gravity="center"
        android:textColor="@color/brandBlueColor_40"
        android:textSize="20dp"
        tools:text="HM" />

    <uz.fido.utils.view.custom_text_view.TextViewMedium
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="8sp"
        android:layout_marginBottom="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:lineSpacingExtra="1.8dp"
        android:maxLines="2"
        android:textColor="@color/brandBlueColor"
        android:textSize="12dp"
        tools:text="Husniddin Madaminov" />

</androidx.appcompat.widget.LinearLayoutCompat>