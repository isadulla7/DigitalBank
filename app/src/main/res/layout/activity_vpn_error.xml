<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <uz.fido.utils.view.custom_empty_view.EmptyView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:ev_desc="@string/please_turn_off_vpn"
        app:ev_icon="@drawable/illustration_vpn_error"
        app:ev_title="@string/network_security_function" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/update"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:text="@string/update"
        android:textColor="@color/frozenWhite"
        android:textSize="16dp"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.appcompat.widget.LinearLayoutCompat>