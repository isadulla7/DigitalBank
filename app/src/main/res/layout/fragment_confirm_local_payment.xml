<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <uz.fido.utils.view.custom_app_bar.MainAppBar
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:s_title="@string/payment_details"/>


    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/details"
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@+id/app_bar"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginVertical="16dp"
        android:layout_height="wrap_content">



        <uz.fido.utils.view.custom_text_view.TextViewRegular
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:textColor="@color/hintColor"
            android:textSize="14dp"
            android:layout_gravity="center_vertical"
            android:text="@string/place"
            android:layout_height="match_parent"/>


        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:id="@+id/value"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:textSize="14dp"
            android:layout_marginTop="4dp"
            android:layout_gravity="center_vertical"
            android:gravity="start"
            android:text="DUPLEX TEL"
            android:textColor="@color/mainTextColor"/>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/lin_amount"
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@+id/details"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginVertical="16dp"
        android:layout_height="wrap_content">



        <uz.fido.utils.view.custom_text_view.TextViewRegular
            android:id="@+id/titlte_amount"
            android:layout_width="match_parent"
            android:textColor="@color/hintColor"
            android:textSize="14dp"
            android:layout_gravity="center_vertical"
            android:text="@string/total_amount"
            android:layout_height="match_parent"/>


        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:id="@+id/text_amount"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:textSize="14dp"
            android:layout_marginTop="4dp"
            android:layout_gravity="center_vertical"
            android:gravity="start"
            android:text="10 000 summ"
            android:textColor="@color/mainTextColor"/>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <uz.fido.universaldigital.ui.utils.choose_card.ChooseCardLayout
        android:id="@+id/choose_card_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/lin_amount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>


    <uz.fido.utils.view.custom_circle_button.CustomFAButton
        android:id="@+id/btn_continue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:enabled="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>