<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?selectableItemBackground"
    android:gravity="center">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#C7CCD2"
        app:cardCornerRadius="30sp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:id="@+id/short_name"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="HM"
            android:textColor="@color/whiteColor"
            android:textSize="20sp" />

    </androidx.cardview.widget.CardView>

    <uz.fido.utils.view.custom_text_view.TextViewRegular
        android:id="@+id/text_name"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center|start"
        android:text="UzCard"
        android:textColor="@color/mainTextColor"
        android:textSize="17sp"
        app:layout_constraintBottom_toTopOf="@id/text_amount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/card_view"
        app:layout_constraintTop_toTopOf="@id/card_view" />

    <uz.fido.utils.view.custom_text_view.TextViewRegular
        android:id="@+id/text_amount"
        android:layout_width="0dp"
        android:layout_height="22sp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center|start"
        android:text="+50 000 UZS"
        android:textColor="#19B28D"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="@id/card_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/card_view"
        app:layout_constraintTop_toBottomOf="@id/text_name" />

    <ImageView
        android:id="@+id/card_type"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="5dp"
        android:src="@drawable/ic_humo_gold_16dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/text_amount"
        app:layout_constraintTop_toBottomOf="@id/text_amount"
        tools:ignore="ContentDescription" />

    <uz.fido.utils.view.custom_text_view.TextViewRegular
        android:id="@+id/card_number"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginStart="4dp"
        android:gravity="center"
        android:text="**3511"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/card_type"
        app:layout_constraintStart_toEndOf="@id/card_type"
        app:layout_constraintTop_toTopOf="@id/card_type" />

    <uz.fido.utils.view.custom_text_view.TextViewRegular
        android:id="@+id/date"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginEnd="16dp"
        android:gravity="center"
        android:text="**3511"
        app:layout_constraintBottom_toBottomOf="@id/card_type"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/card_type" />

</androidx.constraintlayout.widget.ConstraintLayout>