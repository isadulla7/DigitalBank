<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false">
    <uz.fido.utils.view.custom_app_bar.MainAppBar
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/whiteColor"
        app:layout_constraintTop_toTopOf="parent"
        app:s_title="@string/credit_type" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/passport_serial_layout"
        style="@style/EditTextInputLayoutStyle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:hint="@string/passport_serial"
        android:textColorHint="@color/hintColor"
        app:layout_constraintTop_toBottomOf="@+id/app_bar">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_passport_serial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:imeOptions="actionNext"
            android:inputType="textNoSuggestions|text|textCapCharacters"
            android:digits="abcdefghijklmnopqrstuvxABCDEFGHIJKLMNOPQRSTUVWXYZ"
            android:maxLength="2"
            android:maxLines="1"
            android:textColor="@color/mainTextColor"
            android:textAllCaps="true"
            android:singleLine="true" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/passport_number_layout"
        style="@style/EditTextInputLayoutStyle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:textColorHint="@color/hintColor"
        android:layout_marginTop="16dp"
        app:hintEnabled="true"
        android:hint="@string/passport_number"
        app:layout_constraintTop_toBottomOf="@+id/passport_serial_layout">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_passport_number"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inputType="number"
            android:imeOptions="actionDone"
            android:digits="0123456789"
            android:textColor="@color/mainTextColor"
            android:maxLength="7"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>






    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/layout_info"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@+id/passport_number_layout"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingTop="16dp">

            <uz.fido.utils.view.custom_text_view.TextViewRegular
                android:id="@+id/text_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/product_name"
                android:textColor="@color/brandBlueColor_40"
                android:textSize="14sp" />

            <uz.fido.utils.view.custom_text_view.TextViewMedium
                android:id="@+id/product_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="fvdvrever"
                android:textColor="@color/mainTextColor"
                android:textSize="16sp" />

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingTop="16dp">

            <uz.fido.utils.view.custom_text_view.TextViewRegular
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/product_fillial"
                android:textColor="@color/brandBlueColor_40"
                android:textSize="14sp" />

            <uz.fido.utils.view.custom_text_view.TextViewMedium
                android:id="@+id/product_fillial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="fvdvrever"
                android:textColor="@color/mainTextColor"
                android:textSize="16sp" />

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingTop="16dp">

            <uz.fido.utils.view.custom_text_view.TextViewRegular
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/credit_id_payment"
                android:textColor="@color/brandBlueColor_40"
                android:textSize="14sp" />

            <uz.fido.utils.view.custom_text_view.TextViewMedium
                android:id="@+id/id_credit_paynet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="fvdvrever"
                android:textColor="@color/mainTextColor"
                android:textSize="16sp" />

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingTop="16dp">

            <uz.fido.utils.view.custom_text_view.TextViewRegular
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/amount"
                android:textColor="@color/brandBlueColor_40"
                android:textSize="14sp" />

            <uz.fido.utils.view.custom_text_view.TextViewMedium
                android:id="@+id/amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="fvdvrever"
                android:textColor="@color/mainTextColor"
                android:textSize="16sp" />

        </LinearLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <uz.fido.utils.view.custom_circle_button.CustomFAButton
        android:id="@+id/btn_continue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>