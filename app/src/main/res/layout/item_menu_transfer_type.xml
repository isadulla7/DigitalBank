<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/father"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:layout_marginTop="12dp"
    android:background="@drawable/transfer_type_ripple_bg"
    android:gravity="center">

    <ImageView
        android:id="@+id/transfer_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        tools:ignore="ContentDescription" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:id="@+id/transfer_type_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/mainTextColor"
            android:textSize="16sp" />

        <uz.fido.utils.view.custom_text_view.TextViewRegular
            android:id="@+id/transfer_type_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/brandBlueColor_50"
            android:textSize="12sp" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <uz.fido.utils.view.custom_text_view.TextViewMedium
        android:id="@+id/tv_soon"
        android:layout_width="120dp"
        android:layout_height="20dp"
        android:layout_marginEnd="-32dp"
        android:layout_marginBottom="16dp"
        android:background="@color/status_waiting"
        android:gravity="center"
        android:paddingStart="16dp"
        android:rotation="45"
        android:text="@string/soon"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.appcompat.widget.LinearLayoutCompat>