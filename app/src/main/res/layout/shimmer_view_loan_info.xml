<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="@color/whiteColor"
    android:layout_marginVertical="16dp"
    android:layout_height="wrap_content">

    <uz.fido.utils.view.custom_text_view.TextViewRegular
        android:id="@+id/nearest_payment"
        android:layout_width="300dp"
        android:layout_height="16sp"
        android:background="@drawable/shimmer_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <uz.fido.utils.view.custom_text_view.TextViewRegular
        android:id="@+id/text_recommended_amount"
        android:layout_width="200dp"
        android:layout_height="20sp"
        android:layout_marginTop="4dp"
        android:background="@drawable/shimmer_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nearest_payment" />

    <uz.fido.utils.view.custom_text_view.TextViewRegular
        android:id="@+id/date"
        android:layout_width="220dp"
        android:layout_height="16sp"
        android:layout_marginTop="4dp"
        android:background="@drawable/shimmer_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_recommended_amount" />

</androidx.constraintlayout.widget.ConstraintLayout>