<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/whiteColor"
    android:clipChildren="false">

    <uz.fido.utils.view.custom_app_bar.MainAppBar
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/whiteColor"
        app:layout_constraintTop_toTopOf="parent"
        app:s_additionalIcon="@drawable/ic_history"
        app:s_title="@string/to_usd_account" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/app_bar">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_receiver_mfo"
                    style="@style/EditTextInputLayoutStyle"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginHorizontal="16dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:hint="@string/receiver_mfo"
                    android:longClickable="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_receiver_mfo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:digits="1234567890"
                        android:focusable="false"
                        android:imeOptions="actionNext"
                        android:inputType="numberDecimal"
                        android:longClickable="false"
                        android:maxLength="5"
                        android:tag="RECEIVER_FILIAL_CODE"
                        android:theme="@style/DefaultEditTextTheme" />

                </com.google.android.material.textfield.TextInputLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="end|center"
                    android:layout_marginEnd="32dp"
                    android:src="@drawable/ic_arrow_down"
                    tools:ignore="ContentDescription" />

            </FrameLayout>

            <uz.fido.utils.view.custom_text_view.TextViewRegular
                android:id="@+id/text_branch_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:textColor="@color/hintColor"
                android:textSize="14dp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/bank_name_progress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:progressTint="@color/brandBlueColor"
                android:visibility="gone" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_receiver_account"
                style="@style/EditTextInputLayoutStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:hint="@string/receiver_account">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_receiver_account"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:digits="1234567890"
                    android:imeOptions="actionNext"
                    android:inputType="numberDecimal"
                    android:maxLength="20"
                    android:tag="RECEIVER_ACCOUNT"
                    android:theme="@style/DefaultEditTextTheme" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_receiver_name"
                style="@style/EditTextInputLayoutStyle"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:hint="@string/receiver_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_receiver_name"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:maxLength="100"
                    android:tag="RECEIVER_NAME"
                    android:theme="@style/DefaultEditTextTheme" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_purpose"
                style="@style/EditTextInputLayoutStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:hint="@string/payment_details"
                android:minHeight="56dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_purpose"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:imeOptions="actionNext"
                    android:inputType="textMultiLine"
                    android:maxLength="300"
                    android:maxLines="6"
                    android:tag="PAYMENT_PURPOSE"
                    android:theme="@style/DefaultEditTextTheme" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_bank_amount"
                style="@style/EditTextInputLayoutStyle"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:hint="@string/amount_in_dollar">

                <uz.fido.utils.view.custom_edit_text.amount_edit_text.AmountEditText
                    android:id="@+id/et_bank_amount"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:digits="1234567890. "
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:tag="AMOUNT"
                    android:theme="@style/DefaultEditTextTheme" />

            </com.google.android.material.textfield.TextInputLayout>

            <ProgressBar
                android:id="@+id/commission_progress_bar"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:progressTint="@color/brandBlueColor"
                android:visibility="gone" />

            <uz.fido.utils.view.custom_text_view.TextViewRegular
                android:id="@+id/text_percent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:textColor="@color/hintColor"
                android:textSize="14dp" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.core.widget.NestedScrollView>

    <uz.fido.utils.view.custom_circle_button.CustomFAButton
        android:id="@+id/btn_continue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:enabled="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>