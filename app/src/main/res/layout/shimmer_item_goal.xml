<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/father"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:foreground="?selectableItemBackground"
    android:paddingHorizontal="16sp">

    <androidx.cardview.widget.CardView
        android:id="@+id/bg_color"
        android:layout_width="72dp"
        android:layout_height="72dp"
        app:cardCornerRadius="36sp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/shimmer_color"
        android:background="@drawable/shimmer_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/linear"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16sp"
        app:layout_constraintBottom_toBottomOf="@id/bg_color"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/bg_color"
        app:layout_constraintTop_toTopOf="@id/bg_color">


        <uz.fido.utils.view.custom_text_view.TextViewRegular
            android:id="@+id/text_name"
            android:layout_width="120dp"
            android:layout_height="18sp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/shimmer_bg"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="15dp" />

        <uz.fido.utils.view.custom_text_view.TextViewRegular
            android:id="@+id/current_amount"
            android:layout_width="220dp"
            android:layout_height="18sp"
            android:layout_marginTop="4dp"
            android:background="@drawable/shimmer_bg" />

        <uz.fido.utils.view.custom_text_view.TextViewRegular
            android:id="@+id/progress_indicator"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/shimmer_bg"
            app:layout_constraintTop_toBottomOf="@id/text_balance" />

        <uz.fido.utils.view.custom_text_view.TextViewRegular
            android:id="@+id/target_amount"
            android:layout_width="120dp"
            android:layout_height="18sp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:background="@drawable/shimmer_bg"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/hintColor"
            android:textSize="15dp" />

    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>