<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <uz.fido.utils.view.custom_app_bar.MainAppBar
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/whiteColor"
        android:outlineSpotShadowColor="@color/appBarShadowColor"
        android:translationZ="@dimen/elevation_8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:s_title="@string/payment_loan" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/app_bar">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="64dp"
            android:orientation="vertical">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:orientation="vertical">


                <uz.fido.utils.view.custom_text_view.TextViewRegular
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:text="@string/credit_type"
                    android:textColor="@color/hintColor"
                    android:textSize="14sp" />


                <uz.fido.utils.view.custom_text_view.TextViewMedium
                    android:id="@+id/text_credit_name"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/mainTextColor"
                    android:textSize="14sp" />


                <uz.fido.utils.view.custom_text_view.TextViewRegular
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:layout_marginTop="16dp"
                    android:text="@string/contract_number"
                    android:textColor="@color/hintColor"
                    android:textSize="14sp" />


                <uz.fido.utils.view.custom_text_view.TextViewMedium
                    android:id="@+id/text_contract_number"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/mainTextColor"
                    android:textSize="14sp" />


                <uz.fido.utils.view.custom_text_view.TextViewRegular
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:layout_marginTop="16dp"
                    android:text="@string/contract_date"
                    android:textColor="@color/hintColor"
                    android:textSize="14sp" />

                <uz.fido.utils.view.custom_text_view.TextViewMedium
                    android:id="@+id/text_contract_date"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/mainTextColor"
                    android:textSize="14sp" />


                <uz.fido.utils.view.custom_text_view.TextViewRegular
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:layout_marginTop="16dp"
                    android:text="@string/credit_amount"
                    android:textColor="@color/hintColor"
                    android:textSize="14sp" />

                <uz.fido.utils.view.custom_text_view.TextViewMedium
                    android:id="@+id/loan_amount"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/mainTextColor"
                    android:textSize="14sp" />


                <uz.fido.utils.view.custom_text_view.TextViewRegular
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:layout_marginTop="16dp"
                    android:text="@string/account_number_for_repayment"
                    android:textColor="@color/hintColor"
                    android:textSize="14sp" />

                <uz.fido.utils.view.custom_text_view.TextViewMedium
                    android:id="@+id/account_number_for_repayment"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/mainTextColor"
                    android:textSize="14sp" />


                <uz.fido.utils.view.custom_text_view.TextViewRegular
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:layout_marginTop="16dp"
                    android:text="@string/repayment_amount"
                    android:textColor="@color/hintColor"
                    android:textSize="14sp" />

                <uz.fido.utils.view.custom_text_view.TextViewMedium
                    android:id="@+id/repayment_amount"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/mainTextColor"
                    android:textSize="14sp" />


                <uz.fido.utils.view.custom_text_view.TextViewRegular
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:layout_marginTop="16dp"
                    android:text="@string/commission"
                    android:textColor="@color/hintColor"
                    android:textSize="14sp" />

                <uz.fido.utils.view.custom_text_view.TextViewMedium
                    android:id="@+id/commission"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/mainTextColor"
                    android:textSize="14sp" />


                <uz.fido.utils.view.custom_text_view.TextViewRegular
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:layout_marginTop="16dp"
                    android:text="@string/total"
                    android:textColor="@color/hintColor"
                    android:textSize="14sp" />

                <uz.fido.utils.view.custom_text_view.TextViewMedium
                    android:id="@+id/text_total_amount"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/mainTextColor"
                    android:textSize="14sp" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <uz.fido.universaldigital.ui.utils.choose_card.ChooseCardLayout
                android:id="@+id/choose_card_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/lin_add" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.core.widget.NestedScrollView>

    <uz.fido.utils.view.custom_circle_button.CustomFAButton
        android:id="@+id/btn_continue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:enabled="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>