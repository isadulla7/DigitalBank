<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <uz.fido.utils.view.custom_app_bar.MainAppBar
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        app:s_title="@string/constructor"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@color/whiteColor"
        android:elevation="4dp"
        android:layout_height="wrap_content"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        app:layout_constraintTop_toBottomOf="@+id/app_bar"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:outlineSpotShadowColor="#0AFFFFFF"
                android:elevation="28dp"
                android:background="@drawable/cornered_bg_12dp_stroke"
                android:layout_marginHorizontal="16dp">
                <uz.fido.utils.view.custom_text_view.TextViewMedium
                    android:id="@+id/percent_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:drawableStart="@drawable/ic_percent_deposit_icon"
                    android:drawablePadding="16dp"
                    android:gravity="center|start"
                    android:text="@string/deposit_percent_text"
                    android:textColor="@color/mainTextColor"
                    android:textSize="14sp"
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    />

                <ProgressBar
                    android:id="@+id/progress"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="8dp"
                    android:visibility="gone"/>
                <uz.fido.utils.view.custom_text_view.TextViewMedium
                    android:id="@+id/percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="center|start"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/mainTextColor"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    />

            </androidx.appcompat.widget.LinearLayoutCompat>




            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <uz.fido.utils.view.custom_text_view.TextViewRegular
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/hintColor"
                    android:textSize="12sp"
                    android:layout_marginStart="32dp"
                    android:text="@string/amount_term"/>

                <uz.fido.utils.view.custom_text_view.TextViewRegular
                    android:id="@+id/percent_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/hintColor"
                    android:textSize="12sp"
                    android:layout_marginHorizontal="8dp"
                    android:text="0.00"/>
            </androidx.appcompat.widget.LinearLayoutCompat>



    <uz.fido.utils.view.custom_text_view.TextViewMedium
        android:layout_width="match_parent"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="24dp"
        android:textSize="16sp"
        android:text="@string/currency_receive"
        android:layout_height="wrap_content"/>
    
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        android:orientation="horizontal"
        android:background="@drawable/usd_background_color"
        android:layout_height="wrap_content">
        
        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:id="@+id/uzs"
            android:layout_width="wrap_content"
            android:text="UZS"
            android:layout_gravity="center_vertical"
            android:paddingVertical="10dp"
            android:paddingHorizontal="24dp"
            android:background="@drawable/cornered_bg_10dp_stroke"
            android:layout_height="wrap_content"/>

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:id="@+id/usd"
            android:layout_width="wrap_content"
            android:text="USD"
            android:layout_gravity="center_vertical"
            android:layout_margin="2dp"
            android:paddingVertical="10dp"
            android:paddingHorizontal="24dp"
            android:layout_height="wrap_content"/>
    </androidx.appcompat.widget.LinearLayoutCompat>


    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/name_layout"
        style="@style/EditTextInputLayoutStyle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:hint="@string/deposit_constructor_name"
        app:layout_constraintTop_toBottomOf="@+id/passport_serial_layout">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_name"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inputType="text"
            android:imeOptions="actionNext"
            android:maxLines="1"
            android:theme="@style/DefaultEditTextTheme" />

    </com.google.android.material.textfield.TextInputLayout>


    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/amount_layout"
        style="@style/EditTextInputLayoutStyle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="24dp"
        android:hint="@string/amount"
        app:layout_constraintTop_toBottomOf="@id/card_view">

        <uz.fido.utils.view.custom_edit_text.amount_edit_text.AmountEditText
            android:id="@+id/et_amount"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inputType="number"
            android:digits=" 0123456789"
            android:imeOptions="actionDone"
            android:maxLength="10"
            android:theme="@style/DefaultEditTextTheme" />

    </com.google.android.material.textfield.TextInputLayout>

     <uz.fido.utils.view.custom_text_view.TextViewMedium
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginHorizontal="16dp"
         android:layout_marginTop="16dp"
         android:textSize="16sp"
         android:textColor="@color/mainTextColor"
         android:text="@string/deposit_term"/>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="12dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/year_layout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:elevation="1dp"
            android:background="@drawable/tab_background_layout_bg"
            android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/year"
                style="@style/EditTextInputLayoutStyle"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:layout_constraintTop_toBottomOf="@id/card_view">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/ed_year"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:inputType="number"
                    android:hint="@string/year"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:focusableInTouchMode="false"
                    android:focusedByDefault="false"
                    android:theme="@style/DefaultEditTextTheme" />

            </com.google.android.material.textfield.TextInputLayout>

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="4dp"
            android:layout_weight="0.3"
            android:src="@drawable/ic_arrow_down"
            android:layout_height="wrap_content"/>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:id="@+id/month_layout"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/tab_background_layout_bg"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/month"
                style="@style/EditTextInputLayoutStyle"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="@string/month"
                app:layout_constraintTop_toBottomOf="@id/card_view">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/ed_month"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:inputType="number"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:focusableInTouchMode="false"
                    android:focusedByDefault="false"
                    android:theme="@style/DefaultEditTextTheme" />

            </com.google.android.material.textfield.TextInputLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="4dp"
                android:layout_weight="0.1"
                android:src="@drawable/ic_arrow_down"
                android:layout_height="wrap_content"/>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:id="@+id/day_layout"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/tab_background_layout_bg"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/day"
                style="@style/EditTextInputLayoutStyle"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="@string/day"
                app:layout_constraintTop_toBottomOf="@id/card_view">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/ed_day"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:inputType="number"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:focusableInTouchMode="false"
                    android:focusedByDefault="false"
                    android:theme="@style/DefaultEditTextTheme" />

            </com.google.android.material.textfield.TextInputLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="4dp"
                android:layout_weight="0.3"
                android:src="@drawable/ic_arrow_down"
                android:layout_height="wrap_content"/>

        </androidx.appcompat.widget.LinearLayoutCompat>


    </androidx.appcompat.widget.LinearLayoutCompat>

            <uz.fido.utils.view.custom_text_view.TextViewRegular
                android:id="@+id/calculated_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/mainTextColor"
                android:textSize="12sp"
                android:layout_marginHorizontal="16dp"/>

    <uz.fido.utils.view.custom_text_view.TextViewMedium
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textSize="16sp"
        android:textColor="@color/mainTextColor"
        android:text="@string/constructor_percent"
        android:layout_marginHorizontal="16dp"/>

    <RadioGroup
        android:id="@+id/radio_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        >

        <RadioButton
            android:id="@+id/add_to_deposit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:textColor="@color/mainTextColor"
            android:text="@string/add_to_deposit" />

        <RadioButton
            android:id="@+id/to_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/mainTextColor"
            android:text="@string/to_card" />
    </RadioGroup>

            <uz.fido.universaldigital.ui.utils.choose_card.ChooseCardLayout
                android:id="@+id/choose_card_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@+id/lin_add"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>


            <uz.fido.utils.view.custom_text_view.TextViewRegular
                android:id="@+id/additional_parameters"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="16dp"
                android:background="@drawable/tab_background_layout_bg"
                android:drawablePadding="16dp"
                android:paddingEnd="16dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:textColor="@color/brandBlueColor_60"
                android:textSize="16sp"
                android:text="@string/extra_option"
                android:drawableEnd="@drawable/ic_arrow_down"/>


        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>

    <uz.fido.utils.view.custom_circle_button.CustomFAButton
        android:id="@+id/btn_continue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:enabled="true"
        android:layout_gravity="end"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>