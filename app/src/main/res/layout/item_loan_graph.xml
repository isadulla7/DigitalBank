<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:paddingHorizontal="16dp"
    android:layout_marginBottom="16dp"
    android:layout_height="wrap_content"
    android:orientation="vertical">

  <androidx.appcompat.widget.LinearLayoutCompat
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal">

      <uz.fido.utils.view.custom_text_view.TextViewMedium
          android:id="@+id/tv_count"
          android:layout_width="36dp"
          android:layout_height="36dp"
          android:text="1"
          android:textSize="16dp"
          android:textColor="@color/brandRedColor_60"
          android:gravity="center"
          android:background="@drawable/deposit_calculator_color"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          />
      <uz.fido.utils.view.custom_text_view.TextViewRegular
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:id="@+id/time"
          android:layout_weight="1"
          android:text="03.07.2023"
          android:textSize="14dp"
          android:textColor="@color/mainTextColor"
          app:layout_constraintStart_toEndOf="@+id/tv_count"
          android:layout_marginStart="16dp"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintBottom_toBottomOf="parent"/>

      <uz.fido.utils.view.custom_text_view.TextViewMedium
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:id="@+id/amount_main"
          android:layout_marginEnd="16dp"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintEnd_toEndOf="parent"/>

  </androidx.appcompat.widget.LinearLayoutCompat>


    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <uz.fido.utils.view.custom_text_view.TextViewRegular
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/principal_amount"
            android:textSize="14dp"
            android:textColor="@color/brandBlueColor_60"
            app:layout_constraintStart_toEndOf="@+id/tv_count"
            android:layout_marginStart="52dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/principal_amount"
            android:textColor="@color/brandBlueColor_60"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <uz.fido.utils.view.custom_text_view.TextViewRegular
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/precent_loan"
            android:textSize="14dp"
            android:textColor="@color/brandBlueColor_60"
            app:layout_constraintStart_toEndOf="@+id/tv_count"
            android:layout_marginStart="52dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/perc"
            android:textColor="@color/brandBlueColor_60"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.appcompat.widget.LinearLayoutCompat>


    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <uz.fido.utils.view.custom_text_view.TextViewRegular
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/remainder"
            android:textSize="14dp"
            android:textColor="@color/brandBlueColor_60"
            app:layout_constraintStart_toEndOf="@+id/tv_count"
            android:layout_marginStart="52dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/remainder"
            android:textColor="@color/brandBlueColor_60"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.appcompat.widget.LinearLayoutCompat>


    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/loan_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <uz.fido.utils.view.custom_text_view.TextViewRegular
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/status_text"
            android:layout_weight="1"
            android:text="@string/status_type"
            android:textSize="14dp"
            android:textColor="@color/brandBlueColor_60"
            app:layout_constraintStart_toEndOf="@+id/tv_count"
            android:layout_marginStart="52dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/status"
            android:textColor="@color/status_identified"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.appcompat.widget.LinearLayoutCompat>




    </androidx.appcompat.widget.LinearLayoutCompat>



