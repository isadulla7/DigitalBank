<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:clipChildren="false">

    <uz.fido.utils.view.custom_app_bar.MainAppBar
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/whiteColor"
        app:layout_constraintTop_toTopOf="parent"
        app:s_title="@string/currency_exchange" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/app_bar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/conversion_changer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_conversion_changer"
                app:layout_constraintBottom_toTopOf="@id/currency_card_block"
                app:layout_constraintEnd_toEndOf="@id/sum_card_block"
                app:layout_constraintTop_toBottomOf="@id/sum_card_block"
                tools:ignore="ContentDescription" />

            <uz.fido.utils.view.custom_text_view.TextViewSemiBold
                android:id="@+id/tv_sender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:includeFontPadding="false"
                android:text="@string/take_off"
                android:textColor="@color/mainTextColor"
                android:textSize="20sp"
                app:layout_constraintTop_toTopOf="parent" />

            <uz.fido.utils.view.custom_text_view.TextViewSemiBold
                android:id="@+id/tv_receiver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="28dp"
                android:includeFontPadding="false"
                android:text="@string/refill"
                android:textColor="@color/mainTextColor"
                android:textSize="20sp"
                app:layout_constraintTop_toBottomOf="@id/sum_card_block" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/sum_card_block"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/tv_sender">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/sender_card_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/card_gradient_1"
                    android:scaleType="centerCrop"
                    app:shapeAppearance="@style/cardBackground" />

                <uz.fido.utils.view.custom_text_view.TextViewMedium
                    android:id="@+id/sender_card_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/frozenWhite"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Карта для покупок" />

                <uz.fido.utils.view.custom_text_view.TextViewSemiBold
                    android:id="@+id/sender_card_balance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginBottom="10dp"
                    android:includeFontPadding="false"
                    android:textColor="@color/frozenWhite"
                    android:textSize="20sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:text="7 519 900 UZS" />

                <uz.fido.utils.view.custom_text_view.TextViewMedium
                    android:id="@+id/sender_card_state"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/red_card_background"
                    android:gravity="center|start"
                    android:paddingStart="16dp"
                    android:paddingEnd="24dp"
                    android:text="@string/card_blocked"
                    android:textColor="@color/frozenWhite"
                    android:textSize="14dp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/sender_card_type"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_visa"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/frozenWhite"
                    tools:ignore="ContentDescription" />

                <uz.fido.utils.view.custom_text_view.TextViewMedium
                    android:id="@+id/sender_card_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="10dp"
                    android:textColor="@color/frozenWhite"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:text="**1356" />

                <uz.fido.utils.view.custom_text_view.TextViewRegular
                    android:id="@+id/tv_choose_sum_card"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/rectangle_12dp_with_gray_bg"
                    android:gravity="center|start"
                    android:paddingHorizontal="16dp"
                    android:text="@string/choose_sender"
                    android:textColor="@color/brandBlueColor_50"
                    android:textSize="16sp"
                    android:visibility="visible" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/currency_card_block"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/tv_receiver">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/receiver_card_background"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/card_gradient_1"
                    android:scaleType="centerCrop"
                    app:shapeAppearance="@style/cardBackground" />

                <uz.fido.utils.view.custom_text_view.TextViewMedium
                    android:id="@+id/receiver_card_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/frozenWhite"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Карта для покупок" />

                <uz.fido.utils.view.custom_text_view.TextViewSemiBold
                    android:id="@+id/receiver_card_balance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginBottom="10dp"
                    android:includeFontPadding="false"
                    android:textColor="@color/frozenWhite"
                    android:textSize="20sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:text="7 519 900 UZS" />

                <uz.fido.utils.view.custom_text_view.TextViewMedium
                    android:id="@+id/receiver_card_state"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/red_card_background"
                    android:gravity="center|start"
                    android:paddingStart="16dp"
                    android:paddingEnd="24dp"
                    android:text="@string/card_blocked"
                    android:textColor="@color/frozenWhite"
                    android:textSize="14dp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/receiver_card_type"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_visa"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/frozenWhite"
                    tools:ignore="ContentDescription" />

                <uz.fido.utils.view.custom_text_view.TextViewMedium
                    android:id="@+id/receiver_card_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="10dp"
                    android:textColor="@color/frozenWhite"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:text="**1356" />

                <uz.fido.utils.view.custom_text_view.TextViewRegular
                    android:id="@+id/tv_choose_currency_card"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/rectangle_12dp_with_gray_bg"
                    android:gravity="center|start"
                    android:paddingHorizontal="16dp"
                    android:text="@string/choose_receiver"
                    android:textColor="@color/brandBlueColor_50"
                    android:textSize="16sp"
                    android:visibility="visible" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <uz.fido.utils.view.custom_text_view.TextViewMedium
                android:id="@+id/tv_current_rate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                android:text="@string/today_rate"
                android:textColor="@color/brandBlueColor_50"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/currency_card_block" />

            <uz.fido.utils.view.custom_text_view.TextViewMedium
                android:id="@+id/current_rate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:textColor="@color/mainTextColor"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="@id/tv_current_rate"
                app:layout_constraintStart_toEndOf="@id/tv_current_rate"
                app:layout_constraintTop_toTopOf="@id/tv_current_rate"
                tools:text="1$ = 10430 сум" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/amount_layout"
                style="@style/EditTextInputLayoutStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                android:hint="@string/input_amount"
                app:layout_constraintTop_toBottomOf="@id/current_rate">

                <uz.fido.utils.view.custom_edit_text.amount_edit_text.AmountEditText
                    android:id="@+id/et_amount"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:digits="1234567890. "
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:tag="AMOUNT"
                    android:theme="@style/DefaultEditTextTheme" />

            </com.google.android.material.textfield.TextInputLayout>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/calculated_amount_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:visibility="invisible"
                app:layout_constraintTop_toBottomOf="@id/amount_layout">

                <uz.fido.utils.view.custom_text_view.TextViewRegular
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/total_conversion_amount"
                    android:textColor="@color/brandBlueColor_50"
                    android:textSize="14sp" />

                <uz.fido.utils.view.custom_text_view.TextViewRegular
                    android:id="@+id/total_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:textColor="@color/mainTextColor"
                    android:textSize="14sp"
                    tools:text="1$ = 10430 сум" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/min_amount_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/amount_layout">

                <uz.fido.utils.view.custom_text_view.TextViewRegular
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/min_amount_conversion"
                    android:textColor="@color/brandBlueColor_50"
                    android:textSize="14sp" />

                <uz.fido.utils.view.custom_text_view.TextViewRegular
                    android:id="@+id/tv_min_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:textColor="@color/mainTextColor"
                    android:textSize="14sp"
                    tools:text="1$ = 10430 сум" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <uz.fido.utils.view.custom_text_view.TextViewMedium
                android:id="@+id/conversion_currency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:text="@string/conversion_currency"
                android:textColor="@color/mainTextColor"
                android:textSize="16sp"
                app:layout_constraintTop_toBottomOf="@id/calculated_amount_layout" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                style="@style/RoundedTabLayoutStyle"
                android:layout_width="160dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/conversion_currency" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <uz.fido.utils.view.custom_circle_button.CustomFAButton
        android:id="@+id/btn_continue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="1dp"
        android:enabled="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>