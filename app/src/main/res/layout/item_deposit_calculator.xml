<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <uz.fido.utils.view.custom_text_view.TextViewMedium
        android:id="@+id/tv_count"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:text="1"
        android:textSize="16dp"
        android:textColor="@color/brandRedColor_60"
        android:gravity="center"
        android:background="@drawable/deposit_calculator_color"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="16dp"
        />
    <uz.fido.utils.view.custom_text_view.TextViewRegular
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/time"
        android:text="03.07.2023"
        android:textSize="14dp"
        android:textColor="@color/hintColor"
        app:layout_constraintStart_toEndOf="@+id/tv_count"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <uz.fido.utils.view.custom_text_view.TextViewMedium
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="258 122.55 сум"
        android:id="@+id/amount"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>