<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/father_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/handle"
        android:layout_width="36dp"
        android:layout_height="5dp"
        android:layout_marginTop="5dp"
        android:src="@drawable/ic_dialog_handle"
        tools:ignore="ContentDescription" />

    <uz.fido.utils.view.custom_text_view.TextViewMedium
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16sp"
        android:layout_marginTop="6sp"
        android:layout_marginEnd="16sp"
        android:gravity="center"
        android:text="@string/choose_service"
        android:textColor="@color/brandBlueColor"
        android:textSize="16sp" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="32dp">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/order_card_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:tag="order_card">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                style="@style/FloatingButtonStyle"
                android:layout_margin="12dp"
                android:clickable="false"
                android:src="@drawable/card_delivery"
                tools:ignore="ContentDescription" />

            <uz.fido.utils.view.custom_text_view.TextViewMedium
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/order_card"
                android:textColor="@color/brandBlueColor"
                android:textSize="16sp" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/add_card_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:tag="add_card">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                style="@style/FloatingButtonStyle"
                android:layout_margin="12dp"
                android:clickable="false"
                android:src="@drawable/add_card"
                tools:ignore="ContentDescription" />

            <uz.fido.utils.view.custom_text_view.TextViewMedium
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_card"
                android:textColor="@color/brandBlueColor"
                android:textSize="16sp" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>


</androidx.appcompat.widget.LinearLayoutCompat>