<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/father"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="16dp"
    android:elevation="28dp"
    android:outlineSpotShadowColor="#0AFFFFFF"
    android:background="@drawable/cornered_bg_12dp_stroke"
    android:orientation="vertical">

    <uz.fido.utils.view.custom_text_view.TextViewSemiBold
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:drawableStart="@drawable/deposit_name_icon"
        android:drawablePadding="12dp"
        android:gravity="center_vertical|start"
        android:textColor="@color/mainTextColor"
        android:textSize="20sp"
        tools:text="Келажак" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:gravity="start|center">

        <uz.fido.utils.view.custom_text_view.TextViewRegular
            android:id="@+id/expire"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:gravity="center|start"
            android:text="@string/deposit_percent"
            android:textColor="@color/brandBlueColor_40"
            android:textSize="14sp" />

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:id="@+id/deposit_expire"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mainTextColor"
            android:textSize="14sp"
            tools:text="До 29%" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/dashed_line" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:gravity="start|center">

        <uz.fido.utils.view.custom_text_view.TextViewRegular
            android:id="@+id/term"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:gravity="center|start"
            android:text="@string/deposit_term"
            android:textColor="@color/brandBlueColor_40"
            android:textSize="14sp" />

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:id="@+id/deposit_term"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mainTextColor"
            android:textSize="14sp"
            tools:text="24 месяцев" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/dashed_line" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:gravity="start|center">

        <uz.fido.utils.view.custom_text_view.TextViewRegular
            android:id="@+id/replenishment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:gravity="center|start"
            android:text="@string/deposit_replenishment"
            android:textColor="@color/brandBlueColor_40"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/deposit_replenishment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/close_x_icon"
            tools:ignore="ContentDescription" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/dashed_line" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="16dp"
        android:gravity="start|center">

        <uz.fido.utils.view.custom_text_view.TextViewRegular
            android:id="@+id/check_okay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:gravity="center|start"
            android:text="@string/deposit_withdrawal"
            android:textColor="@color/brandBlueColor_40"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/deposit_check_okay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/check_okay_deposit"
            tools:ignore="ContentDescription" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.appcompat.widget.LinearLayoutCompat>