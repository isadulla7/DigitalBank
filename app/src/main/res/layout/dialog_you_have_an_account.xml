<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <ImageView
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_dialog_handle"
        tools:ignore="ContentDescription" />

    <uz.fido.utils.view.custom_text_view.TextViewSemiBold
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="@string/you_already_have_account"
        android:textSize="16dp" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/open_myid"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/whiteColor"
        android:foreground="?selectableItemBackground"
        android:gravity="center"
        android:paddingHorizontal="16dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="40dp"
            android:src="@drawable/myid_logo"
            tools:ignore="ContentDescription" />

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="16dp"
            android:paddingStart="12dp"
            android:text="@string/recover_with_identification"
            android:textColor="@color/mainTextColor"
            android:textSize="15dp" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <uz.fido.utils.view.custom_text_view.TextViewRegular
        android:id="@+id/continue_sign_up"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/whiteColor"
        android:foreground="?selectableItemBackground"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:text="@string/continue_registration"
        android:textColor="@color/mainTextColor"
        android:textSize="15dp" />

</androidx.appcompat.widget.LinearLayoutCompat>
