<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    xmlns:tools="http://schemas.android.com/tools">

    <uz.fido.utils.view.custom_app_bar.MainAppBar
        android:id="@+id/app_bar"
        app:s_title="@string/loan"
        android:background="@color/whiteColor"
       app:layout_constraintTop_toTopOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/lin_button"
        app:layout_constraintTop_toBottomOf="@id/app_bar">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical">



    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/lin_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:outlineSpotShadowColor="#0AFFFFFF"
        android:elevation="28dp"
        app:layout_constraintTop_toBottomOf="@id/app_bar"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/cornered_bg_12dp_stroke"
        app:layout_constraintEnd_toEndOf="parent">
        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:id="@+id/loan_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:drawableStart="@drawable/ic_min_amount_icon"
            android:drawablePadding="16dp"
            android:gravity="center|start"
            tools:text="Сумма кредита до 10 000 000.00 UZS"
            android:textColor="@color/mainTextColor"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            />

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:id="@+id/percent_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:drawableStart="@drawable/ic_percent_deposit_icon"
            android:drawablePadding="16dp"
            android:gravity="center|start"
            android:text="@string/deposit_percent"
            android:textColor="@color/mainTextColor"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            />

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="16dp"
            android:drawableStart="@drawable/ic_timer_deposit"
            android:drawablePadding="16dp"
            android:layout_marginVertical="16dp"
            android:gravity="center|start"
            tools:text="Срок вклад 25 месяцев"
            android:textColor="@color/mainTextColor"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            />

    </androidx.appcompat.widget.LinearLayoutCompat>



    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/amount_lin"
        style="@style/EditTextInputLayoutStyle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="24dp"
        android:hint="@string/monthly_payment"
        app:layout_constraintTop_toBottomOf="@id/lin_info">


        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_amount"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inputType="number"
            android:maxLength="10"
            android:maxLines="1"
            android:focusableInTouchMode="false"
            android:focusedByDefault="false"
            android:text="0.00"
            android:imeOptions="actionDone"
            android:digits=" 0123456789"
            android:theme="@style/DefaultEditTextTheme" />

    </com.google.android.material.textfield.TextInputLayout>



        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/amount_max_min"
            style="@style/EditTextInputLayoutStyle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:hint="@string/loan_amount"
            app:layout_constraintTop_toBottomOf="@id/amount_lin">


            <uz.fido.utils.view.custom_edit_text.amount_edit_text.AmountEditText
                android:id="@+id/et_amount_min_max"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:inputType="number"
                android:maxLength="10"
                android:maxLines="1"
                android:imeOptions="actionDone"
                android:digits=" 0123456789"
                android:theme="@style/DefaultEditTextTheme" />

        </com.google.android.material.textfield.TextInputLayout>



    <androidx.appcompat.widget.AppCompatSeekBar
        android:id="@+id/seekBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/amount_max_min"
        android:layout_width="match_parent"
        android:layout_marginTop="8dp"
        android:progressDrawable="@drawable/seek_bar"
        android:progressTint="@color/brandRedColor"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:thumb="@drawable/ic_thumbler"
        />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/amount_time"
        style="@style/EditTextInputLayoutStyle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:hint="@string/loan_time"
        app:endIconMode="custom"
        app:layout_constraintTop_toBottomOf="@id/seekBar">


        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_time"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inputType="number"
            android:maxLength="10"
            android:maxLines="1"
            tools:text="1"
            android:focusableInTouchMode="false"
            android:focusedByDefault="false"
            android:imeOptions="actionDone"
            android:digits=" 0123456789"
            android:theme="@style/DefaultEditTextTheme" />

    </com.google.android.material.textfield.TextInputLayout>



    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/payment_time"
        style="@style/EditTextInputLayoutStyle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="24dp"
        android:hint="@string/payment_time"
        android:visibility="gone"
        app:endIconMode="custom"
        app:endIconDrawable="@drawable/ic_arrow_down"
        app:layout_constraintTop_toBottomOf="@id/amount_time">


        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_payment_time"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inputType="number"
            android:maxLength="10"
            android:maxLines="1"
            android:focusableInTouchMode="false"
            android:focusedByDefault="false"
            android:imeOptions="actionDone"
            android:digits=" 0123456789"
            android:theme="@style/DefaultEditTextTheme" />

    </com.google.android.material.textfield.TextInputLayout>


    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/loan_type"
        style="@style/EditTextInputLayoutStyle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:visibility="gone"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="24dp"
        android:hint="@string/loan_type"
        app:endIconMode="custom"
        app:endIconDrawable="@drawable/ic_arrow_down"
        app:layout_constraintTop_toBottomOf="@id/payment_time">


        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_loan_type"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inputType="number"
            android:maxLength="10"
            android:focusableInTouchMode="false"
            android:focusedByDefault="false"
            android:maxLines="1"
            android:imeOptions="actionDone"
            android:digits=" 0123456789"
            android:theme="@style/DefaultEditTextTheme" />

    </com.google.android.material.textfield.TextInputLayout>


        <uz.fido.universaldigital.ui.utils.choose_card.ChooseCardLayout
            android:id="@+id/choose_card_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/lin_add"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>


    </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>

   <androidx.appcompat.widget.LinearLayoutCompat
       android:id="@+id/lin_button"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="horizontal"
       app:layout_constraintBottom_toBottomOf="parent">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical">

        <CheckBox
            android:id="@+id/check_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/hintColor" />

        <TextView
            android:id="@+id/text_privacy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/accept_deposit_privacy" />

    </LinearLayout>

       <uz.fido.utils.view.custom_circle_button.CustomFAButton
           android:id="@+id/btn_continue"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:enabled="true"
           android:layout_gravity="end"
           app:layout_constraintBottom_toBottomOf="parent"
           app:layout_constraintEnd_toEndOf="parent" />
   </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.constraintlayout.widget.ConstraintLayout>