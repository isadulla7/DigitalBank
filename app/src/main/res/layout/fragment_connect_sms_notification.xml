<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/whiteColor"
    android:clipChildren="false"
    android:orientation="vertical">

    <uz.fido.utils.view.custom_app_bar.MainAppBar
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:s_title="@string/connect_sms_notification" />

    <uz.fido.utils.view.custom_text_view.TextViewRegular
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16sp"
        android:layout_marginTop="20dp"
        android:includeFontPadding="false"
        android:text="@string/sms_notification_for_only_universalbank_humo_cards"
        android:textColor="@color/brandBlueColor_60"
        android:textSize="14dp"
        app:layout_constraintTop_toBottomOf="@id/owner_name" />

    <uz.fido.utils.view.custom_text_view.TextViewRegular
        android:id="@+id/sms_phone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16sp"
        android:layout_marginTop="8dp"
        android:includeFontPadding="false"
        android:text="@string/sms_notification_turned_on_current_phone"
        android:textColor="@color/brandBlueColor_60"
        android:textSize="14dp"
        app:layout_constraintTop_toBottomOf="@id/subtitle" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/card_number_layout"
        style="@style/EditTextInputLayoutStyle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="16sp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16sp"
        android:hint="@string/input_card_number"
        app:layout_constraintTop_toBottomOf="@id/app_bar">

        <EditText
            android:id="@+id/card_number"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autofillHints="phone"
            android:digits="1234567890 "
            android:imeOptions="actionDone"
            android:inputType="number"
            android:maxLength="19"
            android:maxLines="1"
            android:singleLine="true"
            android:textSize="16sp"
            android:theme="@style/DefaultEditTextTheme"
            app:met_mask="#### #### #### ####" />

    </com.google.android.material.textfield.TextInputLayout>

    <ImageView
        android:id="@+id/image_scanner"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="4dp"
        android:padding="12dp"
        android:src="@drawable/ic_transfer_scanner"
        app:layout_constraintBottom_toBottomOf="@id/card_number_layout"
        app:layout_constraintEnd_toEndOf="@id/card_number_layout"
        app:layout_constraintTop_toTopOf="@id/card_number_layout"
        tools:ignore="ContentDescription" />

    <uz.fido.utils.view.custom_text_view.TextViewRegular
        android:id="@+id/owner_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:drawablePadding="6dp"
        android:paddingHorizontal="16dp"
        android:textColor="@color/brandBlueColor"
        android:textSize="14dp"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_humo_gold_16dp"
        app:layout_constraintStart_toStartOf="@id/card_number_layout"
        app:layout_constraintTop_toBottomOf="@id/card_number_layout" />

    <uz.fido.utils.view.custom_circle_button.CustomFAButton
        android:id="@+id/btn_continue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:enabled="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
