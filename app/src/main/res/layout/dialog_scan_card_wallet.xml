<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/handle"
        android:layout_width="36dp"
        android:layout_height="5dp"
        android:layout_gravity="center"
        android:layout_marginTop="5dp"
        android:src="@drawable/ic_dialog_handle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <uz.fido.utils.view.custom_text_view.TextViewMedium
        android:id="@+id/tv_choose_function"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:paddingBottom="8dp"
        android:text="@string/card_or_phone_number"
        android:textColor="@color/mainTextColor"
        android:textSize="16dp"
        app:layout_constraintTop_toBottomOf="@id/handle" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/tv_choose_function"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:id="@+id/scan_card"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="16dp"
            android:drawableStart="@drawable/ic_scan_card"
            android:drawablePadding="12dp"
            android:gravity="center|start"
            android:paddingHorizontal="12dp"
            android:text="@string/scan_card_number"
            android:textColor="@color/brandBlueColor"
            android:textSize="14dp" />

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:id="@+id/contact"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="16dp"
            android:drawableStart="@drawable/ic_menu_card_contact"
            android:drawablePadding="12dp"
            android:gravity="center|start"
            android:paddingHorizontal="12dp"
            android:text="@string/select_phone_from_contact"
            android:textColor="@color/brandBlueColor"
            android:textSize="14dp" />

        <uz.fido.utils.view.custom_text_view.TextViewMedium
            android:id="@+id/wallet"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:visibility="gone"
            android:layout_marginHorizontal="16dp"
            android:drawableStart="@drawable/ic_card_type_wallet_main"
            android:drawablePadding="12dp"
            android:gravity="center|start"
            android:layout_marginBottom="16dp"
            android:paddingHorizontal="12dp"
            android:text="@string/transfer_t0_wallet"
            android:textColor="@color/brandBlueColor"
            android:textSize="14dp" />
    </androidx.appcompat.widget.LinearLayoutCompat>


</androidx.constraintlayout.widget.ConstraintLayout>