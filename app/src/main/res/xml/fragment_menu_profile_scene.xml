<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ConstraintSet android:id="@+id/start">

        <Constraint android:id="@+id/widget" />
        <Constraint android:id="@id/profile_image">
            <Layout
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <CustomAttribute
                app:attributeName="roundPercent"
                app:customFloatValue="1" />
        </Constraint>
        <Constraint android:id="@id/bottom_layout">
            <Layout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/tv_identified_client" />
        </Constraint>
        <Constraint android:id="@+id/user_name">
            <Layout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toTopOf="@id/user_phone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/profile_image"
                app:layout_constraintTop_toTopOf="@id/profile_image" />
            <CustomAttribute
                app:attributeName="textColor"
                app:customColorValue="@color/brandBlueColor" />
        </Constraint>
        <Constraint android:id="@+id/user_phone">
            <Layout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="@id/profile_image"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/profile_image"
                app:layout_constraintTop_toBottomOf="@id/user_name" />
            <CustomAttribute
                app:attributeName="textColor"
                app:customColorValue="@color/brandBlueColor_40" />
        </Constraint>
        <Constraint android:id="@+id/tv_identified_client">
            <Layout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:gravity="center|start"
                android:paddingHorizontal="16dp"
                app:layout_constraintTop_toBottomOf="@id/profile_image" />
        </Constraint>
        <Constraint android:id="@+id/verified_icon">
            <Layout
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="@id/tv_identified_client"
                app:layout_constraintStart_toStartOf="@id/tv_identified_client"
                app:layout_constraintTop_toTopOf="@id/tv_identified_client" />
            <CustomAttribute
                app:attributeName="colorFilter"
                app:customColorValue="@color/status_identified" />
        </Constraint>
    </ConstraintSet>

    <ConstraintSet android:id="@+id/end">
        <Constraint android:id="@id/widget" />
        <Constraint android:id="@id/profile_image">
            <Layout
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginStart="0dp"
                android:layout_marginTop="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <CustomAttribute
                app:attributeName="roundPercent"
                app:customFloatValue="0.000001" />
        </Constraint>
        <Constraint android:id="@id/bottom_layout">
            <Layout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/profile_image" />
        </Constraint>
        <Constraint android:id="@+id/user_name">
            <Layout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="4dp"
                app:layout_constraintBottom_toTopOf="@id/user_phone"
                app:layout_constraintStart_toStartOf="parent" />
            <CustomAttribute
                app:attributeName="textColor"
                app:customColorValue="@color/white" />
        </Constraint>
        <Constraint android:id="@+id/user_phone">
            <Layout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="@id/profile_image"
                app:layout_constraintStart_toStartOf="parent" />
            <CustomAttribute
                app:attributeName="textColor"
                app:customColorValue="@color/white" />
        </Constraint>
        <Constraint
            android:id="@+id/tv_identified_client"
            android:visibility="invisible">
            <Layout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="32dp"
                android:gravity="center|start"
                android:paddingHorizontal="16dp"
                app:layout_constraintBottom_toBottomOf="@id/profile_image" />
        </Constraint>
        <Constraint
            android:id="@+id/verified_icon"
            app:transitionEasing="cubic(0.12,0.89,0.8,0.8)">
            <Layout
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="@id/user_name"
                app:layout_constraintStart_toEndOf="@id/user_name"
                app:layout_constraintTop_toTopOf="@id/user_name" />
            <CustomAttribute
                app:attributeName="colorFilter"
                app:customColorValue="@color/white" />
            <Transform android:rotationY="360" />
        </Constraint>
    </ConstraintSet>

    <Transition
        app:constraintSetEnd="@+id/end"
        app:constraintSetStart="@+id/start"
        app:duration="754"
        app:motionInterpolator="easeInOut">
        <OnSwipe
            app:dragDirection="dragUp"
            app:maxAcceleration="65.32"
            app:maxVelocity="10"
            app:touchAnchorId="@id/bottom_layout"
            app:touchAnchorSide="top" />
    </Transition>
</MotionScene>
