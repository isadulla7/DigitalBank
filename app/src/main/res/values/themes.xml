<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.UniversalMobileDigital" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/brandRedColor</item>
        <item name="colorPrimaryVariant">@color/white</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondaryContainer">@color/white</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!--splash activity start-->
    <style name="Theme.App.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="postSplashScreenTheme">@style/Base.Theme.UniversalMobileDigital</item>
        <item name="colorPrimary">@color/white</item>
        <item name="splashScreenIconSize">170dp</item>

        <item name="colorPrimaryVariant">@color/white</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Widget.BottomNavigationView" parent="Widget.Design.BottomNavigationView">
        <item name="fontFamily">@font/inter</item>
        <item name="android:textSize">12dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="DefaultEditTextTheme" parent="Widget.AppCompat.EditText">
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_width">56dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">16dp</item>
        <item name="android:textColor">@color/brandBlueColor</item>
        <item name="hintTextColor">@color/brandBlueColor_60</item>
        <item name="android:maxLines">1</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="colorAccent">@color/brandRedColor</item>
        <item name="android:colorAccent">@color/brandRedColor</item>
    </style>

    <style name="DefaultEditTextThemeWithNoFont" parent="Widget.AppCompat.EditText">
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_width">56dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">16dp</item>
        <item name="android:textColor">@color/brandBlueColor</item>
        <item name="hintTextColor">@color/brandBlueColor_60</item>
        <item name="android:maxLines">1</item>
        <item name="colorAccent">@color/brandRedColor</item>
        <item name="android:colorAccent">@color/brandRedColor</item>
    </style>

    <style name="EditTextInputLayoutStyle" parent="Widget.MaterialComponents.TextInputLayout.FilledBox.Dense">
        <item name="errorTextColor">@color/brandRedColor</item>
        <item name="colorAccent">@color/white</item>
        <item name="hintEnabled">true</item>
        <item name="hintTextColor">@color/brandBlueColor_60</item>
        <item name="passwordToggleDrawable">@drawable/custom_eye_toggle</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeColor">@color/white</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="errorEnabled">false</item>
        <item name="errorIconDrawable">@null</item>
        <item name="boxBackgroundColor">@color/etBackgroundColor</item>
    </style>


    <style name="TabLayoutText" parent="Widget.Design.TabLayout">
        <item name="android:textSize">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="ShapeAppearanceOverlayExtended" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">32dp</item>
    </style>

    <style name="MyExpandedTitle" parent="@style/TextAppearance.Design.CollapsingToolbar.Expanded">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textColor">@color/mainTextColor</item>
        <item name="android:textSize">24dp</item>
    </style>

    <style name="MyCollapsedTitle" parent="@style/TextAppearance.AppCompat.Title">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">@color/mainTextColor</item>
        <item name="android:textSize">16dp</item>
    </style>

    <style name="RoundedTabLayoutStyle">
        <item name="tabBackground">@drawable/tabs_selector</item>
        <item name="tabIndicator">@drawable/tabs_selector</item>
        <item name="tabIndicatorColor">@null</item>
        <item name="tabRippleColor">@null</item>
        <item name="tabTextAppearance">@style/TabLayoutTextStyle</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/tab_background_layout_bg</item>
        <item name="tabSelectedTextColor">@color/viewPagerTextColor</item>
        <item name="tabTextColor">@color/viewPagerTextColor</item>
    </style>

    <style name="TabLayoutTextStyle">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:textSize">14dp</item>

    </style>

    <style name="AppBottomSheetDialogThemetwo" parent="Theme.AppCompat.DayNight.DialogWhenLarge">
        <item name="bottomSheetStyle">@style/AppModalStyle</item>
        <item name="android:colorAccent">@color/white</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowFullscreen">false</item>

        <!-- This is important! Don't forget to set window background -->
        <item name="android:windowBackground">@color/white</item>
        <item name="colorAccent">@color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="colorPrimaryDark">@color/blackColor</item>
        <item name="colorPrimary">@color/white</item>
        <item name="colorOnSurface">@color/white</item>
    </style>


    <style name="AppModalStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/dialog_bg</item>
        <item name="behavior_peekHeight">700dp</item>
    </style>

    <style name="AppBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/AppModalStyle</item>
        <item name="android:colorAccent">@color/mainTextColor</item>
        <item name="android:windowIsFloating">false</item>
        <item name="colorAccent">@color/mainTextColor</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="DefaultSwitchTheme" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="checkedIconTint">@color/brandRedColor</item>
    </style>

    <style name="DialogTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorAccent">@color/brandRedColor</item>
        <item name="colorControlNormal">@color/brandRedColor</item>
    </style>

    <style name="my_dialog_theme" parent="ThemeOverlay.AppCompat.Dialog">
        <item name="colorAccent">@color/brandRedColor
        </item>                   <!--header background-->
        <item name="android:windowBackground">@color/white</item>     <!--calendar background-->
        <item name="android:colorControlActivated">@color/brandRedColor</item> <!--selected day-->
        <item name="android:textColorPrimary">@color/mainTextColor</item> <!--days of the month-->
        <item name="android:textColorSecondary">@color/mainTextColor
        </item>    <!--days of the week-->
    </style>

    <style name="Theme.AABMobile.AppWidgetContainerParent" parent="@android:style/Theme.DeviceDefault">
        <!-- Radius of the outer bound of widgets to make the rounded corners -->
        <item name="appWidgetRadius">16dp</item>
        <!--
        Radius of the inner view's bound of widgets to make the rounded corners.
        It needs to be 8dp or less than the value of appWidgetRadius
        -->
        <item name="appWidgetInnerRadius">16dp</item>
    </style>

    <style name="Theme.AABMobile.AppWidgetContainer" parent="Theme.AABMobile.AppWidgetContainerParent">
        <!-- Apply padding to avoid the content of the widget colliding with the rounded corners -->
        <item name="appWidgetPadding">16dp</item>
    </style>

    <style name="weekText" parent="Widget.AppCompat.TextView">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/blackColor</item>
    </style>

    <style name="CalenderViewCustom" parent="Theme.AppCompat">
        <item name="colorControlActivated">@color/brandRedColor</item>
        <item name="android:textColorPrimary">@color/brandBlueColor</item>
    </style>

    <style name="CalenderViewWeekCustomText" parent="android:TextAppearance.DeviceDefault.Small">
        <item name="android:textColor">@color/blackColor</item>
        <item name="font">@font/inter_medium</item>
        <item name="fontStyle">normal</item>
        <item name="monthFontFamily">@font/inter_bold</item>
    </style>

    <style name="CalenderViewDateCustomText" parent="android:TextAppearance.DeviceDefault.Small">
        <item name="android:textColor">@drawable/calender_date_selector</item>
        <item name="font">@font/inter_regular</item>
    </style>
</resources>