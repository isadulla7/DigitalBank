<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.UniversalMobileDigital" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/brandRedColor</item>
        <item name="colorPrimaryVariant">@color/whiteColor</item>
        <item name="colorOnPrimary">@color/whiteColor</item>
        <item name="colorSecondaryContainer">@color/cardBgColor</item>
        <item name="android:statusBarColor">@color/whiteColor</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!--splash activity start-->
    <style name="Theme.App.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/whiteColor</item>
        <item name="postSplashScreenTheme">@style/Base.Theme.UniversalMobileDigital</item>
        <item name="colorPrimary">@color/whiteColor</item>
        <item name="colorPrimaryVariant">@color/whiteColor</item>
        <item name="colorOnPrimary">@color/whiteColor</item>
        <item name="android:statusBarColor">@color/whiteColor</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Widget.BottomNavigationView" parent="Widget.Design.BottomNavigationView">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="DefaultEditTextTheme" parent="Widget.AppCompat.EditText">
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_width">56dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/brandBlueColor</item>
        <item name="hintTextColor">@color/brandBlueColor_60</item>
        <item name="android:maxLines">1</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="colorAccent">@color/brandRedColor</item>
        <item name="android:colorAccent">@color/brandRedColor</item>
    </style>

    <style name="EditTextInputLayoutStyle" parent="Widget.MaterialComponents.TextInputLayout.FilledBox.Dense">
        <item name="errorTextColor">@color/brandRedColor</item>
        <item name="colorAccent">@color/white</item>
        <item name="hintEnabled">true</item>
        <item name="hintTextColor">@color/brandBlueColor_60</item>
        <item name="passwordToggleDrawable">@drawable/custom_eye_toggle</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeColor">@color/white</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="errorEnabled">false</item>
        <item name="errorIconDrawable">@null</item>
        <item name="boxBackgroundColor">@color/etBackgroundColor</item>
    </style>

    <style name="TabLayoutText" parent="Widget.Design.TabLayout">
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="ShapeAppearanceOverlayExtended" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">32dp</item>
    </style>
</resources>